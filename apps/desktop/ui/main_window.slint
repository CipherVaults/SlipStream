                import-metalink-clicked => { root.add-import-metalink-clicked(); }
                source-text <=> root.add-source-text;
                probing: root.add-probing;
                submitting: root.add-submitting;
                error-text: root.add-error-text;
                active-tab <=> root.add-tab;
                has-probe: root.add-has-probe;
