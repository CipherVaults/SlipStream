                torrent-preview-files: root.torrent-preview-files;
                torrent-preview-filter <=> root.add-torrent-preview-filter;
                torrent-start-paused <=> root.add-torrent-start-paused;
                torrent-preview-file-toggled(index) => { root.torrent-preview-file-toggled(index); }
                torrent-preview-select-all => { root.torrent-preview-select-all(); }
                torrent-preview-select-none => { root.torrent-preview-select-none(); }
                torrent-preview-filter-edited(value) => { root.torrent-preview-filter-edited(value); }
                torrent-sequential <=> root.add-torrent-sequential;
