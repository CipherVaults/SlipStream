                error-text: root.create-torrent-error-text;
                success-text: root.create-torrent-success-text;
                browse-source-file-clicked => { root.create-torrent-browse-source-file-clicked(); }
                browse-source-folder-clicked => { root.create-torrent-browse-source-folder-clicked(); }
                browse-output-clicked => { root.create-torrent-browse-output-clicked(); }
                create-clicked => { root.create-torrent-create-clicked(); }
