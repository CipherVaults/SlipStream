    title: "SlipStream";
    icon: @image-url("../icons/icon.png");
    preferred-width: 1340px;
    preferred-height: 820px;
    min-width: 1024px;
    min-height: 640px;
    no-frame: true;
    background: Theme.bg-canvas;
    default-font-family: Theme.font-sans;

    forward-focus: shortcuts;
    init => { shortcuts.focus(); }

    changed theme-light => { Theme.is-light = root.theme-light; }
    changed theme-mono => { Theme.is-mono = root.theme-mono; }
    changed remove-confirm-open => {
        if (!root.remove-confirm-open) { shortcuts.focus(); }
    }

    public function focus-remove-confirm() {
        remove-confirm-focus.focus();
    }

    shortcuts := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (root.remove-confirm-open) { return reject; }
            if (!root.modal-open && !root.speed-popover-open && event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all-visible();
                return accept;
            }
            if (!root.modal-open && event.modifiers.control && (event.text == "k" || event.text == "K")) {
                root.open-palette-clicked();
                return accept;
            }
            if (!root.modal-open && event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.open-add-dialog-clicked();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.create-torrent-open) { root.create-torrent-close-requested(); return accept; }
                if (root.context-menu-open) { root.context-menu-open = false; return accept; }
                if (root.palette-open) { root.palette-open = false; return accept; }
                if (root.verify-open) { root.verify-open = false; return accept; }
                if (root.refresh-open) { root.refresh-open = false; return accept; }
                if (root.add-open) { root.add-close-requested(); return accept; }
                if (root.grabber-open) { root.grabber-close-requested(); return accept; }
                if (root.settings-open) { root.settings-close-requested(); return accept; }
                if (root.speed-popover-open) { root.speed-popover-open = false; return accept; }
                if (root.bulk-editor != 0) { root.bulk-editor = 0; return accept; }
                if (root.selected-count > 0) { root.clear-selection(); return accept; }
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg-canvas;
            border-radius: root.is-maximized ? 0px : 10px;
            border-width: root.is-maximized ? 0px : 1px;
            border-color: Theme.border-strong;
            clip: true;

            HorizontalLayout {
                padding: 0px;
                spacing: 0px;

                // ========================= LEFT SIDEBAR (228px) =========================
                Rectangle {
                    width: 228px;
                    background: Theme.bg-sidebar;

                    Rectangle {
                        x: parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // Brand Bar (52px)
                        Rectangle {
                            height: 52px;

                            TouchArea {
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        root.start-drag();
                                    }
                                }
                                double-clicked => { root.toggle-maximize-window(); }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 9px;

                                Image {
                                    source: @image-url("../icons/icon.png");
                                    width: 28px;
                                    height: 28px;
                                    image-fit: contain;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: "SlipStream";
                                    font-family: Theme.font-display;
                                    font-size: 14.5px;
                                    font-weight: 700;
                                    color: Theme.text-1;
                                    vertical-alignment: center;
                                }

                                if root.demo-mode : PillBadge {
                                    text: "DEMO";
                                    tone: 3;
                                }
                            }
                        }

                        // Scroll the filters as a group while keeping telemetry visible.
                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            VerticalLayout {
                            alignment: start;
                            padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;
                            spacing: 2px;

                            Text {
                                text: "TRANSFERS";
                                font-size: 10.5px;
                                font-weight: 700;
                                letter-spacing: 0.7px;
                                color: Theme.text-3;
                                height: 22px;
                                vertical-alignment: center;
                            }

                            SidebarNavRow {
                                label: "All Transfers";
                                icon: @image-url("icons/grid-2x2.svg");
                                count: root.count-all;
                                active: root.active-nav == "all";
                                clicked => { root.nav-selected("all"); }
                            }
                            SidebarNavRow {
                                label: "Active";
                                icon: @image-url("icons/arrow-down-to-line.svg");
                                count: root.count-active;
                                active: root.active-nav == "active";
                                clicked => { root.nav-selected("active"); }
                            }
                            SidebarNavRow {
                                label: "Completed";
                                icon: @image-url("icons/check-circle-2.svg");
                                count: root.count-completed;
                                active: root.active-nav == "completed";
                                clicked => { root.nav-selected("completed"); }
                            }
                            SidebarNavRow {
                                label: "Queued";
                                icon: @image-url("icons/clock-3.svg");
                                count: root.count-queued;
                                active: root.active-nav == "queued";
                                clicked => { root.nav-selected("queued"); }
                            }
                            SidebarNavRow {
                                label: "Torrents";
                                icon: @image-url("icons/magnet.svg");
                                count: root.count-torrents;
                                active: root.active-nav == "torrents";
                                clicked => { root.nav-selected("torrents"); }
                            }
                            SidebarNavRow {
                                label: "Paused";
                                icon: @image-url("icons/pause.svg");
                                count: root.count-paused;
                                active: root.active-nav == "paused";
                                clicked => { root.nav-selected("paused"); }
                            }

                            SidebarSectionHeader {
                                label: "CATEGORIES";
                                expanded: root.categories-expanded;
                                filtered: root.active-category-filter != "";
                                clicked => { root.categories-expanded = !root.categories-expanded; }
                            }
                            if root.categories-expanded : VerticalLayout {
                                spacing: 1px;
                                if root.active-category-filter != "" : SidebarNavRow {
                                    height: 26px;
                                    label: "Clear category filter";
                                    icon: @image-url("icons/x.svg");
                                    clicked => { root.category-filter-changed(""); }
                                }
                                for category in root.categories : SidebarNavRow {
                                    height: 28px;
                                    label: category.name;
                                    count: category.count;
                                    icon: @image-url("icons/folder.svg");
                                    active: root.active-category-filter == category.id;
                                    clicked => { shortcuts.focus(); root.category-filter-changed(category.id); }
                                }
                            }
                            SidebarSectionHeader {
                                label: "TAGS";
                                expanded: root.tags-expanded;
                                filtered: root.active-tag-filter != "";
                                clicked => { root.tags-expanded = !root.tags-expanded; }
                            }
                            if root.tags-expanded : VerticalLayout {
                                spacing: 1px;
                                if root.tags.length == 0 : Text {
                                    text: "No tags";
                                    color: Theme.text-3;
                                    font-size: 11px;
                                }
                                if root.active-tag-filter != "" : SidebarNavRow {
                                    height: 26px;
                                    label: "Clear tag filter";
                                    icon: @image-url("icons/x.svg");
                                    clicked => { root.tag-filter-changed(""); }
                                }
                                for entry in root.tags : SidebarNavRow {
                                    height: 26px;
                                    label: entry.tag;
                                    count: entry.count;
                                    icon: @image-url("icons/link-2.svg");
                                    active: root.active-tag-filter == entry.tag;
                                    clicked => { shortcuts.focus(); root.tag-filter-changed(entry.tag); }
                                }
                            }
                            SidebarSectionHeader {
                                label: "QUEUES";
                                expanded: root.queues-expanded;
                                filtered: root.active-queue-filter != "";
                                clicked => { root.queues-expanded = !root.queues-expanded; }
                            }
                            if root.queues-expanded : VerticalLayout {
                                spacing: 2px;
                                if root.active-queue-filter != "" : SidebarNavRow {
                                    height: 26px;
                                    label: "Clear queue filter";
                                    icon: @image-url("icons/x.svg");
                                    clicked => { root.queue-filter-changed(""); }
                                }
                                for queue in root.queue-items : HorizontalLayout {
                                    spacing: 2px;
                                    SidebarNavRow {
                                        horizontal-stretch: 1;
                                        height: 28px;
                                        label: queue.paused ? (queue.name + " (Paused)") : queue.name;
                                        count: queue.count;
                                        icon: @image-url("icons/list-ordered.svg");
                                        active: root.active-queue-filter == queue.id;
                                        clicked => { shortcuts.focus(); root.queue-filter-changed(queue.id); }
                                    }
                                    CircleIconButton {
                                        icon: queue.paused ? @image-url("icons/play-filled.svg") : @image-url("icons/pause-filled.svg");
                                        icon-size: 11px;
                                        ghost-square: true;
                                        y: 1px;
                                        clicked => { root.toggle-queue-paused(queue.id, !queue.paused); }
                                    }
                                }
                            }
                            }
                        }

                        // Sidebar Footer: Telemetry Card + Storage + Controls
                        Rectangle {
                            vertical-stretch: 0;
                            background: Theme.sidebar-footer-tint;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                alignment: start;
                                padding-top: 13px; padding-right: 14px; padding-bottom: 13px; padding-left: 14px;
                                spacing: 10px;

                                // Speed summary
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        Text {
                                            text: "Down";
                                            font-size: 11px;
                                            color: Theme.text-3;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.speed-down-text;
                                            font-family: Theme.font-mono;
                                            font-size: 12.5px;
                                            font-weight: 700;
                                            color: Theme.text-1;
                                        }
                                    }
                                    HorizontalLayout {
                                        Text {
                                            text: "Up";
                                            font-size: 11px;
                                            color: Theme.text-3;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.speed-up-text;
                                            font-family: Theme.font-mono;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: Theme.text-2;
                                        }
                                    }
                                }

                                SparklineChart {
                                    line-commands: root.spark-line-cmd;
                                    fill-commands: root.spark-fill-cmd;
                                    vb-width: 180;
                                    vb-height: 28;
                                    detailed: false;
                                }

                                Text {
                                    text: root.active-summary-text;
                                    font-size: 11px;
                                    color: Theme.text-3;
                                    overflow: elide;
                                }

                                // Disk bar
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        Text {
                                            text: "Storage";
                                            font-size: 11px;
                                            color: Theme.text-3;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.disk-free-text;
                                            font-family: Theme.font-mono;
                                            font-size: 10.5px;
                                            color: Theme.text-2;
                                        }
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Theme.track;
                                        clip: true;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 4px;
                                            width: parent.width * Math.clamp(root.disk-used-ratio, 0.04, 1.0);
                                            border-radius: 2px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    GhostButton {
                                        horizontal-stretch: 1;
                                        label: root.all-paused ? "Resume All" : "Pause All";
                                        icon: root.all-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                                        has-icon: true;
                                        btn-height: 28px;
                                        pad-x: 8px;
                                        clicked => { root.toggle-pause-all-clicked(); }
                                    }
                                    CircleIconButton {
                                        icon: @image-url("icons/settings.svg");
                                        clicked => { root.open-settings-clicked(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ========================= RIGHT COLUMN (TOOLBAR + WORKSPACE) =========================
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 0px;
                    spacing: 0px;

                    top-bar := Rectangle {
                        property <length> inset: root.width < 1160px ? 10px : 18px;
                        property <length> gap: root.width < 1160px ? 5px : 9px;
                        property <bool> two-rows: self.width
                            < top-navigation.min-width + top-tools.preferred-width
                                + top-chrome.width + self.inset + 8px + 2 * self.gap;

                        height: self.two-rows ? 86px : 52px;
                        background: Theme.bg-canvas;

                        Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.border;
                        }

                        top-navigation := HorizontalLayout {
                            x: top-bar.inset;
                            y: 11px;
                            width: (top-bar.two-rows ? top-chrome.x : top-tools.x) - self.x - top-bar.gap;
                            height: 30px;
                            spacing: top-bar.gap;

                            PrimaryButton {
                                label: root.width < 1160px ? "Add" : "Add Download";
                                icon: @image-url("icons/plus.svg");
                                has-icon: true;
                                clicked => { root.open-add-dialog-clicked(); }
                            }

                            // Search box
                            Rectangle {
                                min-width: 92px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                height: 30px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-input;
                                border-width: 1px;
                                border-color: search-ti.has-focus ? Theme.accent : Theme.border;

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 8px;
                                    spacing: 7px;

                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: Theme.text-3;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    search-ti := TextInput {
                                        horizontal-stretch: 1;
                                        text <=> root.search-query;
                                        font-family: Theme.font-sans;
                                        font-size: 12px;
                                        color: Theme.text-1;
                                        vertical-alignment: center;
                                        single-line: true;
                                        edited => { root.search-changed(self.text); }
                                    }

                                }
                            }

                            GhostButton {
                                label: root.inspector-collapsed ? "Show Panel" : "Hide Panel";
                                btn-height: 30px;
                                pad-x: 8px;
                                clicked => {
                                    root.inspector-collapsed = !root.inspector-collapsed;
                                    if !root.inspector-collapsed { root.studio-mode-changed(root.studio-mode); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 2px;
                                TransferActionButton {
                                    label: "Cards";
                                    active-highlight: !root.compact-table-view;
                                    clicked => { shortcuts.focus(); root.table-view-changed(false); }
                                }
                                TransferActionButton {
                                    label: "Table";
                                    active-highlight: root.compact-table-view;
                                    clicked => { shortcuts.focus(); root.table-view-changed(true); }
                                }
                            }

                            GhostButton {
                                label: "Drop Basket";
                                btn-height: 30px;
                                pad-x: 7px;
                                active-highlight: root.show-drop-basket;
                                clicked => { root.toggle-drop-basket(); }
                            }
                            GhostButton {
                                label: "Grabber";
                                btn-height: 30px;
                                pad-x: 7px;
                                clicked => { root.open-grabber-clicked(); }
                            }

                            // Drag spacer
                            Rectangle {
                                horizontal-stretch: 1;
                                TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            root.start-drag();
                                        }
                                    }
                                    double-clicked => { root.toggle-maximize-window(); }
                                }
                            }
                        }

                        top-tools := HorizontalLayout {
                            width: self.preferred-width;
                            height: 30px;
                            x: top-bar.two-rows ? top-bar.width - self.width - 8px : top-chrome.x - self.width - top-bar.gap;
                            y: top-bar.two-rows ? 46px : 11px;
                            spacing: top-bar.gap;

                            if root.vpn-kill-switch-active : PillBadge {
                                y: 6px;
                                text: "VPN Blocked";
                                tone: 3;
                            }

                            if root.automation-badge != "" : PillBadge {
                                y: 6px;
                                text: root.automation-badge;
                                tone: root.automation-badge-tone;
                            }

                            GhostButton {
                                label: root.width < 1180px ? "Snail" : (root.alt-speed-active ? "Snail On" : "Snail");
                                icon: @image-url("icons/timer.svg");
                                has-icon: true;
                                btn-height: 30px;
                                active-highlight: root.alt-speed-active;
                                clicked => { root.toggle-alt-speed-clicked(); }
                            }

                            GhostButton {
                                label: root.width < 1160px ? "Limit" : root.speed-limit-label;
                                icon: @image-url("icons/gauge.svg");
                                has-icon: true;
                                btn-height: 30px;
                                active-highlight: root.speed-limit-active;
                                clicked => {
                                    root.speed-popover-open = !root.speed-popover-open;
                                }
                            }

                            CircleIconButton {
                                icon: @image-url("icons/command.svg");
                                clicked => { root.open-palette-clicked(); }
                            }

                            CircleIconButton {
                                icon: root.theme-light ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
                                clicked => { root.toggle-theme-clicked(); }
                            }

                            CircleIconButton {
                                icon: @image-url("icons/settings.svg");
                                clicked => { root.open-settings-clicked(); }
                            }
                        }

                        top-chrome := HorizontalLayout {
                            width: self.preferred-width;
                            x: top-bar.width - self.width - 8px;
                            y: 11px;
                            height: 30px;
                            spacing: 2px;
                            padding-left: 6px;

                            Rectangle {
                                width: 34px;
                                height: 30px;
                                border-radius: 6px;
                                background: w-min.has-hover ? Theme.bg-hover : transparent;
                                Image {
                                    source: @image-url("icons/minus.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.text-2;
                                    x: 11px;
                                    y: 9px;
                                }
                                w-min := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.minimize-window(); }
                                }
                            }

                            Rectangle {
                                width: 34px;
                                height: 30px;
                                border-radius: 6px;
                                background: w-max.has-hover ? Theme.bg-hover : transparent;
                                Image {
                                    source: @image-url("icons/square.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: Theme.text-2;
                                    x: 11.5px;
                                    y: 9.5px;
                                }
                                w-max := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-maximize-window(); }
                                }
                            }

                            Rectangle {
                                width: 34px;
                                height: 30px;
                                border-radius: 6px;
                                background: w-close.has-hover ? Theme.red-hover : transparent;
                                Image {
                                    source: @image-url("icons/x.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: w-close.has-hover ? #FFFFFF : Theme.text-2;
                                    x: 11px;
                                    y: 9px;
                                }
                                w-close := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.close-window(); }
                                }
                            }
                        }
                    }

                    // Workspace split: Transfer List + Inspector
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding: 0px;
                        spacing: 0px;

                        // Central Transfer Pane
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.bg-canvas;

                            if !root.has-transfers : VerticalLayout {
                                alignment: center;
                                spacing: 10px;

                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: 16px;
                                    background: Theme.accent-soft;
                                    x: (parent.width - self.width) / 2;

                                    Image {
                                        source: @image-url("icons/download.svg");
                                        width: 24px;
                                        height: 24px;
                                        colorize: Theme.accent;
                                        x: 16px;
                                        y: 16px;
                                    }
                                }

                                Text {
                                    text: root.search-query != "" || root.active-category-filter != "" || root.active-tag-filter != "" || root.active-nav != "all" ? "No matching transfers" : "Ready to download";
                                    font-family: Theme.font-display;
                                    font-size: 15px;
                                    font-weight: 650;
                                    color: Theme.text-1;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Paste a URL or drop a .torrent, .txt, or .ef2 file.";
                                    wrap: word-wrap;
                                    font-size: 12.5px;
                                    color: Theme.text-2;
                                    horizontal-alignment: center;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    PrimaryButton {
                                        label: "Add Download";
                                        icon: @image-url("icons/plus.svg");
                                        has-icon: true;
                                        clicked => { root.open-add-dialog-clicked(); }
                                    }
                                }
                            }

                            if root.compact-table-view && root.has-transfers : Rectangle {
                                y: transfer-bar.height;
                                width: parent.width;
                                height: parent.height - self.y;

                                Rectangle {
                                    y: 0px;
                                    height: 34px;
                                    width: table-scroll.visible-width;
                                    x: 0px;
                                    clip: true;
                                    TransferTableRow {
                                        x: table-scroll.content-x;
                                        width: table-scroll.content-width;
                                        heading: true;
                                        sort-column: root.sort-column;
                                        sort-ascending: root.sort-ascending;
                                        sort(column) => { root.sort-changed(column); }
                                    }
                                }

                                table-scroll := ScrollView {
                                    y: 34px;
                                    width: parent.width;
                                    height: parent.height - self.y;
                                    content-width: Math.max(self.visible-width, 638px);
                                    VerticalLayout {
                                        width: table-scroll.content-width;
                                        alignment: start;
                                        for item in root.transfer-rows : TransferTableRow {
                                            item: item;
                                            clicked => { shortcuts.focus(); root.select-transfer(item.id); }
                                            double-clicked => {
                                                if item.is-completed { root.open-completed-file(item.id); }
                                                else { root.open-floating-progress(item.id); }
                                            }
                                            context-clicked(x, y) => { root.open-context-menu(item.id, x, y); }
                                        }
                                    }
                                }
                            }
                            if !root.compact-table-view && root.has-transfers : ScrollView {
                                y: transfer-bar.height;
                                width: 100%;
                                height: parent.height - self.y;
                                content-width: self.visible-width;

                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 18px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px;
                                    spacing: 16px;

                                    // Playlist Queue Groups
                                    if root.playlist-groups.length > 0 : VerticalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: "PLAYLIST QUEUES";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            letter-spacing: 0.7px;
                                            color: Theme.text-3;
                                        }

                                        for grp in root.playlist-groups : Rectangle {
                                            border-radius: Theme.radius-lg;
                                            background: Theme.bg-elevated;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            drop-shadow-blur: 6px;
                                            drop-shadow-color: Theme.card-shadow;

                                            VerticalLayout {
                                                padding-top: 12px; padding-right: 14px; padding-bottom: 12px; padding-left: 14px;
                                                spacing: 10px;

                                                HorizontalLayout {
                                                    spacing: 10px;

                                                    CircleIconButton {
                                                        icon: grp.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                                                        ghost-square: true;
                                                        y: 6px;
                                                        clicked => { root.toggle-playlist-expand(grp.playlist-id); }
                                                    }

                                                    Rectangle {
                                                        width: 38px;
                                                        height: 38px;
                                                        border-radius: 9px;
                                                        background: Theme.accent-soft;
                                                        Image {
                                                            source: @image-url("icons/list-video.svg");
                                                            width: 18px;
                                                            height: 18px;
                                                            colorize: Theme.accent;
                                                            x: 10px;
                                                            y: 10px;
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        spacing: 3px;
                                                        Text {
                                                            text: grp.title;
                                                            font-size: 13px;
                                                            font-weight: 650;
                                                            color: Theme.text-1;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: grp.summary-line;
                                                            font-size: 11.5px;
                                                            color: Theme.text-2;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    if grp.has-pause-items || grp.has-resume-items : CircleIconButton {
                                                        icon: grp.is-paused ? @image-url("icons/play-filled.svg") : @image-url("icons/pause-filled.svg");
                                                        icon-size: 12px;
                                                        y: 4px;
                                                        clicked => { root.toggle-playlist-pause(grp.playlist-id, grp.is-paused); }
                                                    }

                                                    CircleIconButton {
                                                        icon: @image-url("icons/folder-open.svg");
                                                        icon-size: 13px;
                                                        y: 4px;
                                                        clicked => { root.reveal-playlist-folder(grp.playlist-id); }
                                                    }
                                                }

                                                if grp.expanded : VerticalLayout {
                                                    spacing: 7px;
                                                    padding-left: 14px;
                                                    for child in grp.items : ActiveTransferCard {
                                                        item: child;
                                                        compact: true;
                                                        selected: child.selected;
                                                        select-clicked(id) => { shortcuts.focus(); root.select-transfer(id); }
                                                        toggle-pause-clicked(id, paused) => { root.toggle-transfer-pause(id, paused); }
                                                        open-floating-clicked(id) => { root.open-floating-progress(id); }
                                                        refresh-link-clicked(id) => { root.open-refresh-dialog(id); }
                                                        remove-clicked(id) => { root.request-remove-transfer(id); }
                                                        context-clicked(id, x, y) => { root.open-context-menu(id, x, y); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Active / Queued / Paused Transfers
                                    if root.active-rows.length > 0 : VerticalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: "ACTIVE & QUEUED";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            letter-spacing: 0.7px;
                                            color: Theme.text-3;
                                        }

                                        for item in root.active-rows : ActiveTransferCard {
                                            item: item;
                                            compact: false;
                                            selected: item.selected;
                                            select-clicked(id) => { shortcuts.focus(); root.select-transfer(id); }
                                            toggle-pause-clicked(id, paused) => { root.toggle-transfer-pause(id, paused); }
                                            open-floating-clicked(id) => { root.open-floating-progress(id); }
                                            refresh-link-clicked(id) => { root.open-refresh-dialog(id); }
                                            remove-clicked(id) => { root.request-remove-transfer(id); }
                                            context-clicked(id, x, y) => { root.open-context-menu(id, x, y); }
                                        }
                                    }

                                    // Completed Section
                                    if root.completed-rows.length > 0 : VerticalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: "COMPLETED";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            letter-spacing: 0.7px;
                                            color: Theme.text-3;
                                        }

                                        for c in root.completed-rows : Rectangle {
                                            height: 44px;
                                            border-radius: 9px;
                                            background: c.selected
                                                ? Theme.accent-soft
                                                : (c-ta.has-hover ? Theme.bg-hover : transparent);
                                            border-width: 1px;
                                            border-color: c.selected ? Theme.accent : Theme.border;

                                            c-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { shortcuts.focus(); root.select-transfer(c.id); }
                                                double-clicked => { root.open-completed-file(c.id); }
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                                        root.open-context-menu(c.id, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                    }
                                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                                                        root.request-remove-transfer(c.id);
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 10px;

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    y: 9px;
                                                    border-radius: 7px;
                                                    background: Theme.green-soft;
                                                    TransferKindIcon {
                                                        icon-kind: c.icon-kind;
                                                        tint: Theme.green;
                                                        width: 14px;
                                                        height: 14px;
                                                        x: 6px;
                                                        y: 6px;
                                                    }
                                                }

                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: c.filename;
                                                    font-size: 12.5px;
                                                    font-weight: 550;
                                                    color: Theme.text-1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }

                                                if c.sha-verified == 1 : PillBadge {
                                                    text: "SHA-256";
                                                    tone: 2;
                                                    has-check: true;
                                                    y: 13px;
                                                }

                                                if c.format-summary != "" : PillBadge {
                                                    text: c.format-summary;
                                                    y: 13px;
                                                }

                                                Text {
                                                    text: c.size-text;
                                                    font-family: Theme.font-mono;
                                                    font-size: 11.5px;
                                                    color: Theme.text-2;
                                                    vertical-alignment: center;
                                                }

                                                CircleIconButton {
                                                    icon: @image-url("icons/external-link.svg");
                                                    icon-size: 12px;
                                                    ghost-square: true;
                                                    y: 9px;
                                                    clicked => { root.open-completed-file(c.id); }
                                                }

                                                CircleIconButton {
                                                    icon: @image-url("icons/folder-open.svg");
                                                    icon-size: 12px;
                                                    ghost-square: true;
                                                    y: 9px;
                                                    clicked => { root.reveal-in-explorer(c.id); }
                                                }

                                                CircleIconButton {
                                                    icon: @image-url("icons/trash-2.svg");
                                                    icon-size: 12px;
                                                    ghost-square: true;
                                                    y: 9px;
                                                    clicked => { root.request-remove-transfer(c.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            transfer-bar := Rectangle {
                                y: 0px;
                                height: root.inspector.has-selection ? actions.preferred-height + 12px : 0px;
                                visible: root.inspector.has-selection;
                                background: Theme.bg-inspector;
                                actions := TransferActions {
                                    x: 10px;
                                    y: 6px;
                                    width: parent.width - 20px;
                                    height: self.preferred-height;
                                    transfer: root.inspector;
                                    selected-count: root.selected-count;
                                    category-options: root.category-options;
                                    queue-options: root.queue-options;
                                    bulk-editor <=> root.bulk-editor;
                                    bulk-limit <=> root.bulk-limit;
                                    bulk-action(action, value) => { root.bulk-action(action, value); }
                                    bulk-category(index) => { root.bulk-category(index); }
                                    bulk-queue(index) => { root.bulk-queue(index); }
                                    action(action) => { root.run-transfer-action(action); }
                                }
                            }
                        }

                        if !root.inspector-collapsed : Rectangle {
                            width: 360px;
                            background: Theme.bg-inspector;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 4px;
                                    for mode in [{ id: 0, label: "Inspector" }, { id: 1, label: "Speed Graph" }, { id: 2, label: "Logs" }] : TransferActionButton {
                                        label: mode.label;
                                        active-highlight: root.studio-mode == mode.id;
                                        clicked => { root.studio-mode-changed(mode.id); }
                                    }
                                }
                                if root.studio-mode == 1 : SpeedGraphPanel {
                                    graph: root.speed-graph;
                                    window-seconds: root.graph-window-seconds;
                                    window-changed(seconds) => { root.graph-window-changed(seconds); }
                                }
                                if root.studio-mode == 2 : LogsPanel {
                                    entries: root.log-entries;
                                    level: root.log-level;
                                    filter(level) => { root.log-filter-changed(level); }
                                    action(action) => { root.log-action(action); }
                                }

                            if root.studio-mode == 0 && !root.inspector.has-selection : Text {
                                vertical-stretch: 1;
                                text: "Select a transfer to see its details";
                                color: Theme.text-2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.studio-mode == 0 && root.inspector.has-selection : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 4px;
                                    TransferActionButton {
                                        label: "General";
                                        active-highlight: root.inspector-tab == 0;
                                        clicked => { root.inspector-tab = 0; }
                                    }
                                    TransferActionButton {
                                        label: root.inspector.is-torrent ? "Files (" + root.inspector.torrent-files.length + ")" : "Files";
                                        active-highlight: root.inspector-tab == 1;
                                        clicked => { root.inspector-tab = 1; }
                                    }
                                    if root.inspector.is-torrent : TransferActionButton {
                                        label: "Peers";
                                        active-highlight: root.inspector-tab == 2;
                                        clicked => { root.inspector-tab = 2; }
                                    }
                                    TransferActionButton {
                                        label: "Segments";
                                        active-highlight: root.inspector-tab == 3;
                                        clicked => { root.inspector-tab = 3; }
                                    }
                                }

                                if root.inspector-tab == 0 : ScrollView {
                                    vertical-stretch: 1;
                                    content-width: self.visible-width;
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            alignment: start;
                                            PillBadge { text: root.inspector.status-label; tone: root.inspector.status-tone; }
                                        }
                                        Text { text: root.inspector.filename; font-size: 15px; font-weight: 650; color: Theme.text-1; wrap: char-wrap; }
                                        Text { text: root.inspector.source-domain + " • " + root.inspector.protocol-label; color: Theme.text-2; font-size: 11px; overflow: elide; }

                                        Rectangle {
                                            background: Theme.bg-elevated;
                                            border-radius: Theme.radius-md;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            VerticalLayout {
                                                padding: 9px;
                                                spacing: 8px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    InspectorMetric { label: "DOWN SPEED"; value: root.inspector.speed-text; }
                                                    InspectorMetric { label: "UP SPEED"; value: root.inspector.upload-speed-text; }
                                                    InspectorMetric { label: "REMAINING"; value: root.inspector.eta-text; }
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    InspectorMetric { label: "PROGRESS"; value: root.inspector.size-text; }
                                                    InspectorMetric { label: root.inspector.is-torrent ? "PEERS" : "CONNECTIONS"; value: root.inspector.connections-text; }
                                                    if root.inspector.is-torrent : InspectorMetric {
                                                        label: "RATIO & PIECES";
                                                        value: root.inspector.ratio-text + " • " + root.inspector.pieces-text;
                                                    }
                                                }
                                            }
                                        }

                                        if root.inspector.is-torrent : Rectangle {
                                            border-radius: Theme.radius-md;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            background: Theme.bg-elevated;
                                            VerticalLayout {
                                                padding: 9px;
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    GhostButton {
                                                        label: "Recheck";
                                                        btn-height: 28px;
                                                        enabled: !root.torrent-action-pending;
                                                        clicked => { root.force-recheck-torrent(root.inspector.id); }
                                                    }
                                                    GhostButton {
                                                        label: "Move Folder";
                                                        btn-height: 28px;
                                                        enabled: !root.torrent-action-pending;
                                                        clicked => { root.move-torrent-storage(root.inspector.id); }
                                                    }
                                                    GhostButton {
                                                        label: "Reannounce";
                                                        btn-height: 28px;
                                                        enabled: !root.torrent-action-pending;
                                                        clicked => { root.reannounce-torrent(root.inspector.id); }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    StyledLineEdit {
                                                        horizontal-stretch: 1;
                                                        text <=> root.add-tracker-input;
                                                        placeholder: "Tracker URL";
                                                        enabled: !root.torrent-action-pending;
                                                        accepted => { root.add-torrent-tracker(root.inspector.id, root.add-tracker-input); }
                                                    }
                                                    GhostButton {
                                                        label: "Add Tracker";
                                                        enabled: !root.torrent-action-pending && root.add-tracker-input != "";
                                                        clicked => { root.add-torrent-tracker(root.inspector.id, root.add-tracker-input); }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "UP LIMIT (KiB/s)";
                                                        font-size: 10px;
                                                        font-weight: 650;
                                                        color: Theme.text-3;
                                                        vertical-alignment: center;
                                                    }
                                                    StyledLineEdit {
                                                        horizontal-stretch: 1;
                                                        text <=> root.torrent-upload-limit-input;
                                                        placeholder: "Unlimited";
                                                        enabled: root.torrent-upload-limit-loaded && !root.torrent-action-pending;
                                                        accepted => { root.apply-torrent-upload-limit(root.inspector.id, root.torrent-upload-limit-input); }
                                                    }
                                                    GhostButton {
                                                        label: "Apply";
                                                        enabled: root.torrent-upload-limit-loaded && !root.torrent-action-pending;
                                                        clicked => { root.apply-torrent-upload-limit(root.inspector.id, root.torrent-upload-limit-input); }
                                                    }
                                                }
                                            }
                                        }

                                        InspectorMetric { label: "SAVE FOLDER"; value: root.inspector.save-dir; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            InspectorMetric { label: "SOURCE URL"; value: root.inspector.source-url; }
                                            GhostButton { label: "Copy"; btn-height: 25px; pad-x: 7px; clicked => { root.copy-transfer-url(root.inspector.id); } }
                                        }

                                        VerticalLayout {
                                            spacing: 5px;
                                            Text { text: "CATEGORY"; color: Theme.text-3; font-size: 10px; font-weight: 650; }
                                            StyledSelect {
                                                options: root.category-options;
                                                enabled: !root.inspector-metadata-saving;
                                                current-index <=> root.inspector-category-index;
                                                current-value: root.category-options[root.inspector-category-index];
                                            }
                                            Text { text: "TAGS"; color: Theme.text-3; font-size: 10px; font-weight: 650; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                StyledLineEdit {
                                                    horizontal-stretch: 1;
                                                    enabled: !root.inspector-metadata-saving;
                                                    text <=> root.inspector-tags;
                                                    placeholder: "Comma-separated tags";
                                                    accepted => { root.apply-inspector-metadata(); }
                                                }
                                                GhostButton {
                                                    label: "Apply";
                                                    enabled: !root.inspector-metadata-saving;
                                                    clicked => { root.apply-inspector-metadata(); }
                                                }
                                            }
                                        }

                                        if root.inspector.trackers-text != "" : InspectorMetric {
                                            label: "TRACKERS";
                                            value: root.inspector.trackers-text;
                                        }

                                        if root.inspector.sha-text != "" : HorizontalLayout {
                                            alignment: start;
                                            PillBadge {
                                                text: root.inspector.sha-text;
                                                tone: root.inspector.sha-tone;
                                                has-check: root.inspector.sha-tone == 2;
                                            }
                                        }

                                        if root.inspector.error-message != "" : Rectangle {
                                            border-radius: 8px;
                                            background: Theme.amber-soft;
                                            border-width: 1px;
                                            border-color: Theme.amber-border;
                                            VerticalLayout {
                                                padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                                Text {
                                                    text: root.inspector.error-message;
                                                    font-size: 11.5px;
                                                    color: Theme.amber;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        if root.inspector.completion-notice != "" : Rectangle {
                                            border-radius: 8px;
                                            background: Theme.green-soft;
                                            VerticalLayout {
                                                padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px;
                                                Text {
                                                    text: root.inspector.completion-notice;
                                                    font-size: 11.5px;
                                                    color: Theme.green;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        TransferActions {
                                            transfer: root.inspector;
                                            expanded: true;
                                            action(action) => { root.run-transfer-action(action); }
                                        }
                                    }
                                }

                                if root.inspector-tab == 1 : VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 8px;
                                    if root.inspector.is-torrent && root.inspector.torrent-files.length > 0 : HorizontalLayout {
                                        spacing: 6px;
                                        GhostButton { label: "All"; enabled: !root.torrent-files-applying; clicked => { root.select-torrent-files(true); } }
                                        GhostButton { label: "None"; enabled: !root.torrent-files-applying; clicked => { root.select-torrent-files(false); } }
                                        PrimaryButton { label: "Apply"; enabled: !root.torrent-files-applying; clicked => { root.apply-torrent-files(root.inspector.id); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.inspector.torrent-files.length == 0 : Text {
                                        text: root.inspector.is-torrent ? "Torrent files will appear when metadata is available." : "File selection is available for torrent transfers.";
                                        color: Theme.text-2;
                                        wrap: word-wrap;
                                    }
                                    if root.inspector.torrent-files.length > 0 : ScrollView {
                                        vertical-stretch: 1;
                                        content-width: self.visible-width;
                                        VerticalLayout {
                                            alignment: start;
                                            spacing: 3px;
                                            for file in root.inspector.torrent-files : VerticalLayout {
                                                if file.folder-label != "" : HorizontalLayout {
                                                    padding-top: 4px;
                                                    Text {
                                                        text: file.folder-label + "/";
                                                        font-size: 10.5px;
                                                        font-weight: 650;
                                                        color: Theme.text-2;
                                                        overflow: elide;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: file.relative-path == file.display-name ? 0px : 12px;
                                                    spacing: 8px;
                                                    CheckBoxRow {
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        controlled: true;
                                                        enabled: !root.torrent-files-applying;
                                                        checked: file.selected;
                                                        label: file.display-name;
                                                        toggled => { root.toggle-torrent-file(file.index); }
                                                    }
                                                    Text {
                                                        horizontal-stretch: 0;
                                                        min-width: 68px;
                                                        text: file.downloaded-text + " / " + file.size-text;
                                                        color: Theme.text-2;
                                                        font-size: 10px;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.inspector-tab == 2 : VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 8px;
                                    Text {
                                        text: root.inspector.peers-summary-text;
                                        color: Theme.text-2;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                    TorrentPeerTable {
                                        vertical-stretch: 2;
                                        peers: root.inspector.peers;
                                        show-peer-details: true;
                                    }
                                    Text { text: "TRACKERS"; color: Theme.text-3; font-size: 10px; font-weight: 700; }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        min-height: 48px;
                                        content-width: self.visible-width;
                                        VerticalLayout {
                                            alignment: start;
                                            Text {
                                                text: root.inspector.trackers-text == "" ? "No trackers reported." : root.inspector.trackers-text;
                                                color: Theme.text-2;
                                                font-size: 11px;
                                                wrap: char-wrap;
                                            }
                                        }
                                    }
                                }

                                if root.inspector-tab == 3 : ScrollView {
                                    vertical-stretch: 1;
                                    content-width: self.visible-width;
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        if root.inspector.segments.length == 0 : Text {
                                            text: "No segments reported for this transfer.";
                                            color: Theme.text-2;
                                        }
                                        if root.inspector.segments.length > 0 : VerticalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "SEGMENTS (" + root.inspector.segments.length + ")";
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                letter-spacing: 0.7px;
                                                color: Theme.text-3;
                                            }
                                            for seg in root.inspector.segments : Rectangle {
                                                height: 24px;
                                                border-radius: 6px;
                                                background: Theme.bg-elevated;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        border-radius: 3.5px;
                                                        y: 8.5px;
                                                        background: seg.state-code == 1 ? Theme.green
                                                            : (seg.state-code == 0 || seg.state-code == 3 ? Theme.accent
                                                            : (seg.state-code == 4 ? Theme.danger : Theme.text-3));
                                                    }
                                                    Text { width: 22px; text: seg.index-text; font-family: Theme.font-mono; font-size: 11px; color: Theme.text-2; vertical-alignment: center; }
                                                    Text { horizontal-stretch: 1; text: seg.bytes-text; font-family: Theme.font-mono; font-size: 11px; color: Theme.text-1; vertical-alignment: center; }
                                                    Text { text: seg.state-label; font-size: 10.5px; color: Theme.text-3; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }

            // Speed limit quick popover (top right of toolbar)
            if root.speed-popover-open : Rectangle {
                x: parent.width - 390px;
                y: top-bar.height + 2px;
                width: 240px;
                height: 112px;
                border-radius: 12px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 20px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: Theme.popover-shadow;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Global Speed Limit (MB/s)";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-1;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        StyledLineEdit {
                            horizontal-stretch: 1;
                            mono: true;
                            text <=> root.speed-popover-input;
                            placeholder: "Empty = Unlimited";
                            accepted => {
                                root.apply-speed-limit-clicked(root.speed-popover-input);
                                root.speed-popover-open = false;
                            }
                        }
                        PrimaryButton {
                            label: "Set";
                            btn-height: 31px;
                            clicked => {
                                root.apply-speed-limit-clicked(root.speed-popover-input);
                                root.speed-popover-open = false;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        GhostButton {
                            label: "Unlimited";
                            btn-height: 24px;
                            pad-x: 8px;
                            clicked => {
                                root.speed-popover-input = "";
                                root.apply-speed-limit-clicked("");
                                root.speed-popover-open = false;
                            }
                        }
                        GhostButton {
                            label: "5 MB/s";
                            btn-height: 24px;
                            pad-x: 8px;
                            clicked => {
                                root.speed-popover-input = "5";
                                root.apply-speed-limit-clicked("5");
                                root.speed-popover-open = false;
                            }
                        }
                        GhostButton {
                            label: "25 MB/s";
                            btn-height: 24px;
                            pad-x: 8px;
                            clicked => {
                                root.speed-popover-input = "25";
                                root.apply-speed-limit-clicked("25");
                                root.speed-popover-open = false;
                            }
                        }
                    }
                }
            }

            if root.context-menu-open : TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { root.context-menu-open = false; }
                }
            }
            if root.context-menu-open : Rectangle {
                width: 174px;
                height: menu.preferred-height;
                x: Math.clamp(root.context-menu-x * 1px, 6px, parent.width - self.width - 6px);
                y: Math.clamp(root.context-menu-y * 1px, 6px, parent.height - self.height - 6px);
                border-radius: Theme.radius-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.popover-shadow;

                TouchArea {}
                menu := VerticalLayout {
                    padding: 5px;
                    spacing: 3px;
                    for entry in [
                        { action: TransferAction.pause, label: "Pause" },
                        { action: TransferAction.stop, label: "Stop" },
                        { action: TransferAction.floating, label: "Open Floating Window" },
                        { action: TransferAction.open-file, label: "Open File" },
                        { action: TransferAction.open-folder, label: "Open Folder" },
                        { action: TransferAction.copy, label: "Copy URL / Magnet" },
                        { action: TransferAction.refresh, label: "Refresh Link" },
                        { action: TransferAction.verify, label: "Verify SHA-256" },
                        { action: TransferAction.remove, label: "Remove..." },
                    ] : GhostButton {
                        label: entry.action == TransferAction.pause && root.inspector.is-paused ? "Resume" : entry.label;
                        enabled: entry.action == TransferAction.pause ? root.inspector.can-pause-resume
                            : entry.action == TransferAction.stop ? root.inspector.can-stop
                            : entry.action == TransferAction.open-file ? root.inspector.is-completed
                            : entry.action == TransferAction.copy ? root.inspector.source-url != ""
                            : entry.action == TransferAction.refresh ? root.inspector.can-refresh-url
                            : entry.action != TransferAction.verify || root.inspector.can-verify;
                        btn-height: 25px;
                        pad-x: 5px;
                        clicked => { root.run-transfer-action(entry.action); }
                    }
                }
            }

            // Overlays
            SettingsOverlay {
                open <=> root.settings-open;
                proxy-mode-index <=> root.set-proxy-mode-index;
                proxy-url <=> root.set-proxy-url;
                proxy-username <=> root.set-proxy-username;
                proxy-password <=> root.set-proxy-password;
                proxy-has-password: root.set-proxy-has-password;
                proxy-bypass-hosts <=> root.set-proxy-bypass-hosts;
                proxy-apply-to-media <=> root.set-proxy-apply-to-media;
                site-logins: root.set-site-logins;
                site-login-host <=> root.set-site-login-host;
                site-login-scheme-index <=> root.set-site-login-scheme-index;
                site-login-username <=> root.set-site-login-username;
                site-login-password <=> root.set-site-login-password;
                network-editing: root.set-network-editing;
                cookies-enabled <=> root.set-cookies-enabled;
                cookies-browser-index <=> root.set-cookies-browser-index;
                cookies-allowed-hosts <=> root.set-cookies-allowed-hosts;
                auto-discover-checksums <=> root.set-auto-discover-checksums;
                media-embed-metadata <=> root.set-media-embed-metadata;
                media-embed-thumbnail <=> root.set-media-embed-thumbnail;
                media-embed-chapters <=> root.set-media-embed-chapters;
                media-split-chapters <=> root.set-media-split-chapters;
                media-sponsorblock-text <=> root.set-media-sponsorblock-text;
                media-filename-template <=> root.set-media-filename-template;
                clear-proxy-password-clicked => { root.settings-clear-proxy-password-clicked(); }
                add-site-login-clicked => { root.settings-add-site-login-clicked(); }
                delete-site-login-clicked(id) => { root.settings-delete-site-login-clicked(id); }
                theme-index <=> root.set-theme-index;
                accent-index <=> root.set-accent-index;
                default-download-dir <=> root.set-default-download-dir;
                default-connections <=> root.set-default-connections;
                max-concurrent <=> root.set-max-concurrent;
                speed-limit-mbps <=> root.set-speed-limit-mbps;
                close-to-tray <=> root.set-close-to-tray;
                auto-defender-scan <=> root.set-auto-defender-scan;
                monitor-clipboard <=> root.set-monitor-clipboard;
                launch-on-startup <=> root.set-launch-on-startup;
                launch-minimized <=> root.set-launch-minimized;
                notify-on-complete <=> root.set-notify-on-complete;
                sound-on-complete <=> root.set-sound-on-complete;
                show-drop-basket <=> root.set-show-drop-basket;
                show-download-dialog <=> root.set-show-download-dialog;
                show-progress-dialog <=> root.set-show-progress-dialog;
                show-complete-dialog <=> root.set-show-complete-dialog;
                update-mode-index <=> root.set-update-mode-index;
                ytdlp-override <=> root.set-ytdlp-override;
                ffmpeg-override <=> root.set-ffmpeg-override;
                ytdlp-status-label: root.set-ytdlp-status-label;
                ytdlp-status-tone: root.set-ytdlp-status-tone;
                ytdlp-version: root.set-ytdlp-version;
                ytdlp-path: root.set-ytdlp-path;
                ffmpeg-status-label: root.set-ffmpeg-status-label;
                ffmpeg-status-tone: root.set-ffmpeg-status-tone;
                ffmpeg-version: root.set-ffmpeg-version;
                ffmpeg-path: root.set-ffmpeg-path;
                ffprobe-status-label: root.set-ffprobe-status-label;
                ffprobe-status-tone: root.set-ffprobe-status-tone;
                ffprobe-path: root.set-ffprobe-path;
                ytdlp-updating: root.set-ytdlp-updating;
                ytdlp-notice: root.set-ytdlp-notice;
                ytdlp-error: root.set-ytdlp-error;
                browsers: root.set-browsers;
                browser-notice: root.set-browser-notice;
                browser-error: root.set-browser-error;
                about-version: root.version-label;
                update-checking: root.set-update-checking;
                update-installing: root.set-update-installing;
                update-available: root.set-update-available;
                update-version-label: root.set-update-version-label;
                update-notes: root.set-update-notes;
                update-progress-percent: root.set-update-progress-percent;
                update-progress-text: root.set-update-progress-text;
