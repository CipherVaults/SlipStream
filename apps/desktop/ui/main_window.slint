import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "./tokens.slint";
import {
    PrimaryButton,
    GhostButton,
    CircleIconButton,
    CheckBoxRow,
    PillBadge,
    SegmentProgressBar,
    SparklineChart,
    StyledLineEdit,
    TorrentPeerTable,
    StyledSelect,
    TransferTableRow,
    DualSpeedGraph,
} from "./widgets.slint";
import {
    TransferRowModel,
    PlaylistGroupModel,
    CategoryNavModel,
    TagChipModel,
    LogEntryModel,
    SpeedGraphModel,
    InspectorModel,
    FormatOptionModel,
    SubtitleItemModel,
    PlaylistItemModel,
    TorrentPreviewFileModel,
    BrowserCardModel,
    PaletteActionModel,
    QueueItem,
    WatchFolderItem,
    RssFeedRuleItem,
    SiteLoginItem,
    SiteGrabItemRow,
} from "./app_types.slint";
import {
    AddDownloadOverlay,
    SettingsOverlay,
    SiteGrabberOverlay,
    CreateTorrentOverlay,
    CommandPaletteOverlay,
    RefreshLinkOverlay,
    VerifyShaOverlay,
} from "./dialogs.slint";

component TransferKindIcon inherits Image {
    in property <int> icon-kind: 0;
    in property <color> tint: Theme.accent;

    width: 18px;
    height: 18px;
    colorize: root.tint;
    source: root.icon-kind == 1 ? @image-url("icons/film.svg")
        : root.icon-kind == 2 ? @image-url("icons/music.svg")
        : root.icon-kind == 3 ? @image-url("icons/archive.svg")
        : root.icon-kind == 4 ? @image-url("icons/app-window.svg")
        : root.icon-kind == 5 ? @image-url("icons/disc.svg")
        : root.icon-kind == 6 ? @image-url("icons/file-text.svg")
        : root.icon-kind == 7 ? @image-url("icons/magnet.svg")
        : @image-url("icons/download.svg");
}

component SidebarNavRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <int> count: 0;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 7px;
    background: root.active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.bg-hover : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 9px;

        Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            colorize: root.active ? Theme.accent : Theme.text-2;
            y: (parent.height - self.height) / 2;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            overflow: elide;
            font-size: 12.5px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.text-1 : Theme.text-2;
            vertical-alignment: center;
        }

        if root.count > 0 : Rectangle {
            width: Math.max(22px, count-label.preferred-width + 12px);
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.active ? Theme.accent : Theme.bg-input;

            count-label := Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.count;
                font-family: Theme.font-mono;
                font-size: 10.5px;
                font-weight: 600;
                color: root.active ? Theme.accent-ink : Theme.text-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActiveTransferCard inherits Rectangle {
    in property <TransferRowModel> item;
    in property <bool> selected: false;
    in property <bool> compact: false;

    callback select-clicked(string);
    callback toggle-pause-clicked(string, bool);
    callback open-floating-clicked(string);
    callback refresh-link-clicked(string);
    callback remove-clicked(string);
    callback context-clicked(string, float, float);

    min-height: root.compact ? 64px : 76px;
    border-radius: Theme.radius-lg;
    background: root.selected
        ? Theme.accent-soft
        : (row-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    drop-shadow-blur: 6px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.card-shadow;

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select-clicked(root.item.id); }
        double-clicked => { root.open-floating-clicked(root.item.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.context-clicked(root.item.id, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                root.remove-clicked(root.item.id);
            }
        }
    }

    HorizontalLayout {
        padding: root.compact ? 10px : 13px;
        spacing: 12px;

        // 44x44 thumbnail tile
        Rectangle {
            width: root.compact ? 36px : 44px;
            height: root.compact ? 36px : 44px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.item.is-torrent ? Theme.green-soft
                : (root.item.is-error ? Theme.amber-soft : Theme.accent-soft);

            TransferKindIcon {
                icon-kind: root.item.icon-kind;
                tint: root.item.is-torrent ? Theme.green
                    : (root.item.is-error ? Theme.amber : Theme.accent);
                width: root.compact ? 16px : 20px;
                height: root.compact ? 16px : 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // Main metadata + 16-segment bar
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: center;

            HorizontalLayout {
                spacing: 7px;

                if root.item.playlist-index-text != "" : PillBadge {
                    text: "#" + root.item.playlist-index-text;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.item.filename;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-1;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.item.tag-text != "" : PillBadge {
                    text: root.item.tag-text;
                    tone: root.item.is-torrent ? 2 : 0;
                }

                if root.item.sha-verified == 1 : PillBadge {
                    text: "SHA-256";
                    tone: 2;
                    has-check: true;
                }

                Text {
                    text: root.item.progress-label;
                    font-family: Theme.font-mono;
                    font-size: 11.5px;
                    font-weight: 650;
                    color: root.item.is-paused ? Theme.text-3
                        : (root.item.is-torrent ? Theme.green : Theme.accent);
                    vertical-alignment: center;
                }
            }

            SegmentProgressBar {
                segments: root.item.segments;
                tone: root.item.segment-tone;
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.item.error-text != "" ? root.item.error-text : root.item.meta-line;
                    font-size: 11.5px;
                    color: root.item.error-text != "" ? Theme.danger : Theme.text-2;
                    overflow: elide;
                }
                Text {
                    text: root.item.source-domain;
                    font-size: 11px;
                    color: Theme.text-3;
                }
            }
        }

        // Quick actions
        HorizontalLayout {
            spacing: 5px;
            alignment: center;

            if root.item.can-pause-resume : CircleIconButton {
                icon: root.item.is-paused ? @image-url("icons/play-filled.svg") : @image-url("icons/pause-filled.svg");
                icon-size: 12px;
                clicked => { root.toggle-pause-clicked(root.item.id, root.item.is-paused); }
            }

            if !root.item.is-completed : CircleIconButton {
                icon: @image-url("icons/app-window.svg");
                icon-size: 13px;
                clicked => { root.open-floating-clicked(root.item.id); }
            }

            if root.item.is-error : CircleIconButton {
                icon: @image-url("icons/refresh-cw.svg");
                icon-size: 13px;
                clicked => { root.refresh-link-clicked(root.item.id); }
            }

            CircleIconButton {
                icon: @image-url("icons/trash-2.svg");
                icon-size: 13px;
                ghost-square: true;
                clicked => { root.remove-clicked(root.item.id); }
            }
        }
    }
}

component InspectorMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    horizontal-stretch: 1;
    spacing: 3px;
    Text { text: root.label; font-size: 9px; font-weight: 700; color: Theme.text-3; }
    Text { text: root.value; font-size: 11px; font-weight: 550; color: Theme.text-1; overflow: elide; }
}

enum TransferAction { pause, stop, floating, open-file, open-folder, copy, refresh, verify, remove }

component TransferActionButton inherits GhostButton {
    btn-height: 26px;
    pad-x: 6px;
}

component TransferActions inherits VerticalLayout {
    in property <InspectorModel> transfer;
    in property <bool> expanded: false;
    in property <int> selected-count: 0;
    in property <[string]> category-options: [];
    in property <[string]> queue-options: [];
    in-out property <int> bulk-editor: 0;
    in-out property <string> bulk-limit: "";
    callback bulk-action(string, string);
    callback bulk-category(int);
    callback bulk-queue(int);
    callback action(TransferAction);
    spacing: 5px;

    if root.selected-count > 1 : VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            PillBadge { text: root.selected-count + " selected"; tone: 1; y: (parent.height - self.height) / 2; }
            for label in ["Pause", "Resume", "Stop", "Category", "Queue", "Limit", "Export URLs", "Remove…"] : TransferActionButton {
                label: label;
                active-highlight: (label == "Category" && root.bulk-editor == 1)
                    || (label == "Limit" && root.bulk-editor == 2)
                    || (label == "Queue" && root.bulk-editor == 3);
                clicked => {
                    if label == "Category" {
                        root.bulk-editor = root.bulk-editor == 1 ? 0 : 1;
                    } else if label == "Limit" {
                        root.bulk-editor = root.bulk-editor == 2 ? 0 : 2;
                    } else if label == "Queue" {
                        root.bulk-editor = root.bulk-editor == 3 ? 0 : 3;
                    } else {
                        root.bulk-editor = 0;
                        root.bulk-action(label, "");
                    }
                }
            }
        }
        if root.bulk-editor == 1 : HorizontalLayout {
            alignment: start;
            spacing: 6px;
            StyledSelect {
                width: 200px;
                options: root.category-options;
                current-value: "Choose a category";
                selected(index, value) => { root.bulk-category(index); }
            }
        }
        if root.bulk-editor == 3 : HorizontalLayout {
            alignment: start;
            spacing: 6px;
            StyledSelect {
                width: 220px;
                options: root.queue-options;
                current-value: "Assign selected to queue";
                selected(index, value) => { root.bulk-queue(index); }
            }
        }
        if root.bulk-editor == 2 : HorizontalLayout {
            alignment: start;
            spacing: 6px;
            StyledLineEdit {
                width: 200px;
                placeholder: "Limit in MB/s (blank = unlimited)";
                text <=> root.bulk-limit;
                accepted => { root.bulk-action("Limit", root.bulk-limit); }
            }
            GhostButton { label: "Apply"; clicked => { root.bulk-action("Limit", root.bulk-limit); } }
        }
    }

    if root.selected-count <= 1 : HorizontalLayout {
        alignment: start;
        spacing: 4px;
        if root.transfer.can-pause-resume : TransferActionButton {
            label: root.transfer.is-paused ? "Resume" : "Pause";
            clicked => { root.action(TransferAction.pause); }
        }
        if root.transfer.can-stop : TransferActionButton {
            label: "Stop";
            clicked => { root.action(TransferAction.stop); }
        }
        TransferActionButton {
            label: "Floating Box";
            clicked => { root.action(TransferAction.floating); }
        }
        if root.transfer.is-completed : TransferActionButton {
            label: "Open File";
            clicked => { root.action(TransferAction.open-file); }
        }
        if !root.expanded : TransferActionButton {
            label: "Open Folder";
            clicked => { root.action(TransferAction.open-folder); }
        }
        if !root.expanded : TransferActionButton {
            label: "Copy Link";
            clicked => { root.action(TransferAction.copy); }
        }
        if !root.expanded : TransferActionButton {
            label: "Export URLs";
            clicked => { root.bulk-action("Export URLs", ""); }
        }
        if !root.expanded : TransferActionButton {
            label: "Remove…";
            clicked => { root.action(TransferAction.remove); }
        }
    }

    if root.expanded && root.selected-count <= 1 : HorizontalLayout {
        alignment: start;
        spacing: 4px;
        TransferActionButton {
            label: "Open Folder";
            clicked => { root.action(TransferAction.open-folder); }
        }
        if root.transfer.can-refresh-url : TransferActionButton {
            label: "Refresh Link";
            clicked => { root.action(TransferAction.refresh); }
        }
        if root.transfer.can-verify : TransferActionButton {
            label: "Verify SHA";
            clicked => { root.action(TransferAction.verify); }
        }
        TransferActionButton {
            label: "Remove...";
            clicked => { root.action(TransferAction.remove); }
        }
    }
}

component SidebarSectionHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded;
    in property <bool> filtered;
    callback clicked();
    height: 26px;
    border-radius: 5px;
    background: header-touch.has-hover ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 5px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.7px;
            color: root.filtered ? Theme.accent : Theme.text-3;
            vertical-alignment: center;
        }
        Image {
            source: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.text-3;
        }
    }
    header-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SpeedGraphPanel inherits VerticalLayout {
    in property <SpeedGraphModel> graph;
    in property <int> window-seconds;
    callback window-changed(int);
    spacing: 10px;

    HorizontalLayout {
        alignment: start;
        spacing: 5px;
        for option in [{ label: "1m", seconds: 60 }, { label: "5m", seconds: 300 }, { label: "30m", seconds: 1800 }] : TransferActionButton {
            label: option.label;
            active-highlight: root.window-seconds == option.seconds;
            clicked => { root.window-changed(option.seconds); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        Text { text: "↓ Download"; color: #378AFF; font-size: 11px; }
        Text { text: "↑ Upload"; color: #21B89C; font-size: 11px; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.graph.scale-max; color: Theme.text-2; font-size: 11px; }
    }
    DualSpeedGraph { graph: root.graph; height: 170px; }
    HorizontalLayout {
        spacing: 8px;
        InspectorMetric { label: "PEAK DOWN"; value: root.graph.peak-down; }
        InspectorMetric { label: "PEAK UP"; value: root.graph.peak-up; }
    }
    HorizontalLayout {
        spacing: 8px;
        InspectorMetric { label: "AVG DOWN"; value: root.graph.avg-down; }
        InspectorMetric { label: "AVG UP"; value: root.graph.avg-up; }
    }
    Rectangle { vertical-stretch: 1; }
}

component LogsPanel inherits VerticalLayout {
    in property <[LogEntryModel]> entries;
    in property <string> level;
    callback filter(string);
    callback action(string);
    spacing: 8px;

    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for label in ["All", "Info", "Warn", "Error"] : TransferActionButton {
            label: label;
            active-highlight: root.level == label;
            clicked => { root.filter(label); }
        }
    }
    if root.entries.length == 0 : Text {
        text: "No log entries";
        color: Theme.text-2;
        font-size: 12px;
        vertical-stretch: 1;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if root.entries.length > 0 : ListView {
        vertical-stretch: 1;
        for entry in root.entries : Rectangle {
            height: entry-layout.preferred-height;
            border-width: 1px;
            border-color: Theme.border;
            entry-layout := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: entry.level; color: entry.level == "ERROR" ? Theme.danger : entry.level == "WARN" ? Theme.amber : Theme.accent; font-size: 10px; font-weight: 650; }
                    Text { text: entry.category; color: Theme.text-2; font-size: 10px; horizontal-stretch: 1; overflow: elide; }
                    Text { text: entry.timestamp; color: Theme.text-3; font-size: 10px; }
                }
                Text { text: entry.message; wrap: char-wrap; color: Theme.text-1; font-size: 11px; }
            }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for label in ["Copy", "Export .log…", "Clear"] : TransferActionButton {
            label: label;
            enabled: root.entries.length > 0 || (root.level != "All" && label != "Copy");
            clicked => { root.action(label); }
        }
    }
}

component ResizeGrip inherits TouchArea {
    in property <int> direction;
    callback resize(int);
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            root.resize(root.direction);
        }
    }
}

export component MainWindow inherits Window {
    // Theme binding
    in-out property <bool> theme-light: false;
    in-out property <bool> theme-mono: false;
    in-out property <bool> is-maximized: false;

    // App header / counts / filter state
    in property <string> version-label: "3.0.0";
    // "all" | "active" | "completed" | "queued" | "torrents" | "paused"
    in-out property <string> active-nav: "all";
    in-out property <string> search-query: "";
    in property <int> count-all: 0;
    in property <int> count-active: 0;
    in property <int> count-completed: 0;
    in property <int> count-queued: 0;
    in property <int> count-torrents: 0;
    in property <int> count-paused: 0;

    // Live global stats
    in property <string> speed-down-text: "0 B/s";
    in property <string> speed-up-text: "0 B/s";
    in property <string> active-summary-text: "Idle";
    in property <string> spark-line-cmd: "M 0 25 L 180 25";
    in property <string> spark-fill-cmd: "M 0 25 L 180 25 L 180 28 L 0 28 Z";
    in property <string> disk-free-text: "-- free";
    in property <float> disk-used-ratio: 0.45;
    in property <string> speed-limit-label: "Unlimited";
    in property <bool> speed-limit-active: false;
    in property <bool> all-paused: false;
    in property <bool> alt-speed-active: false;
    in property <string> automation-badge: "";
    in property <int> automation-badge-tone: 0;

    // Speed limit popover state
    in-out property <bool> speed-popover-open: false;
    in-out property <string> speed-popover-input: "";

    // Transfer lists & selection
    in property <bool> compact-table-view: false;
    in property <string> sort-column: "date";
    in property <bool> sort-ascending: false;
    in property <int> selected-count: 0;
    in-out property <int> bulk-editor: 0;
    in-out property <string> bulk-limit: "";
    in property <[CategoryNavModel]> categories: [];
    in property <[TagChipModel]> tags: [];
    in property <[string]> category-options: [];
    in property <[QueueItem]> queue-items: [];
    in property <[string]> queue-options: ["Main Queue"];
    in-out property <string> active-category-filter: "";
    in-out property <string> active-tag-filter: "";
    in-out property <string> active-queue-filter: "";
    property <bool> categories-expanded: true;
    property <bool> tags-expanded: true;
    property <bool> queues-expanded: true;
    in-out property <int> inspector-category-index: 0;
    in-out property <string> inspector-tags: "";
    in property <bool> inspector-metadata-saving: false;
    in-out property <int> studio-mode: 0;
    in property <int> graph-window-seconds: 60;
    in property <SpeedGraphModel> speed-graph;
    in property <string> log-level: "All";
    in property <[LogEntryModel]> log-entries: [];
    in property <bool> show-drop-basket: false;
    property <bool> has-transfers: root.transfer-rows.length > 0;
    property <bool> modal-open: root.remove-confirm-open || root.add-open || root.settings-open
        || root.palette-open || root.refresh-open || root.verify-open || root.create-torrent-open || root.grabber-open;
    in-out property <string> selected-id: "";
    in property <[PlaylistGroupModel]> playlist-groups: [];
    in property <[TransferRowModel]> active-rows: [];
    in property <[TransferRowModel]> completed-rows: [];
    in property <[TransferRowModel]> transfer-rows: [];
    in property <InspectorModel> inspector;
    in-out property <bool> inspector-collapsed: false;
    in-out property <int> inspector-tab: 0;
    in property <bool> torrent-files-applying: false;
    in property <bool> vpn-kill-switch-active: false;
    in-out property <string> add-tracker-input: "";
    in-out property <string> torrent-upload-limit-input: "";
    in property <bool> torrent-upload-limit-loaded: false;
    in property <bool> torrent-action-pending: false;
    in-out property <bool> context-menu-open: false;
    in property <float> context-menu-x: 0;
    in property <float> context-menu-y: 0;
    in-out property <bool> remove-confirm-open: false;
    in property <string> remove-confirm-id: "";
    in property <string> remove-confirm-filename: "";
    in property <bool> toast-visible: false;
    in property <string> toast-text: "";
    in property <bool> toast-error: false;

    function run-transfer-action(action: TransferAction) {
        root.context-menu-open = false;
        if action == TransferAction.pause { root.toggle-transfer-pause(root.inspector.id, root.inspector.is-paused); }
        if action == TransferAction.stop { root.stop-transfer(root.inspector.id); }
        if action == TransferAction.floating { root.open-floating-progress(root.inspector.id); }
        if action == TransferAction.open-file { root.open-completed-file(root.inspector.id); }
        if action == TransferAction.open-folder { root.reveal-in-explorer(root.inspector.id); }
        if action == TransferAction.copy { root.copy-transfer-url(root.inspector.id); }
        if action == TransferAction.refresh { root.open-refresh-dialog(root.inspector.id); }
        if action == TransferAction.verify { root.open-verify-dialog(root.inspector.id); }
        if action == TransferAction.remove { root.request-remove-transfer(root.inspector.id); }
    }

    // Demo badge
    in property <bool> demo-mode: false;

    // Overlay component states
    in-out property <bool> add-open: false;
    in-out property <string> add-source-text: "";
    in property <bool> add-probing: false;
    in property <bool> add-submitting: false;
    in property <string> add-error-text: "";
    in-out property <int> add-tab: 0;
    in property <bool> add-has-probe: false;
    in property <bool> add-is-torrent-input: false;
    in property <bool> add-is-direct-http: false;
    in property <string> add-probe-title: "";
    in property <string> add-probe-meta: "";
    in property <bool> add-is-playlist: false;
    in property <int> add-playlist-count: 0;
    in property <int> add-playlist-selected-count: 0;
    in-out property <string> add-playlist-folder-name: "";
    in-out property <string> add-playlist-filter: "";
    in property <[PlaylistItemModel]> add-playlist-items: [];
    in property <[FormatOptionModel]> add-format-options: [];
    in-out property <int> add-container-index: 0;
    in-out property <int> add-audio-preset-index: 0;
    in-out property <bool> add-embed-subtitles: true;
    in-out property <bool> add-lossless-remux: true;
