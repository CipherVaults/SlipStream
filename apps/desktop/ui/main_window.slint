                close-requested => { root.palette-open = false; }
                query-edited(q) => { root.palette-query-edited(q); }
                action-triggered(id) => { root.palette-action-triggered(id); }
            }

            RefreshLinkOverlay {
                open <=> root.refresh-open;
                filename: root.refresh-filename;
                new-url <=> root.refresh-url;
                submitting: root.refresh-submitting;
                error-text: root.refresh-error;
                close-requested => { root.refresh-open = false; }
                submit-clicked => { root.refresh-submit-clicked(); }
            }

            VerifyShaOverlay {
                open <=> root.verify-open;
                filename: root.verify-filename;
                expected-sha256 <=> root.verify-sha;
                submitting: root.verify-submitting;
                error-text: root.verify-error;
                close-requested => { root.verify-open = false; }
                submit-clicked => { root.verify-submit-clicked(); }
            }
            remove-confirm-focus := FocusScope {
                width: 100%;
                height: 100%;
                visible: root.remove-confirm-open;
                enabled: root.remove-confirm-open;

                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.remove-confirm-open = false; }
                    return accept;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.modal-backdrop;
                    TouchArea {}
                    Rectangle {
                        width: 436px;
                        height: remove-content.preferred-height;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-lg;
                        background: Theme.bg-elevated;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        remove-content := VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text { text: root.remove-confirm-id == "" ? "Remove selected transfers?" : "Remove transfer?"; font-size: 16px; font-weight: 650; color: Theme.text-1; }
                            Text { text: root.remove-confirm-filename; color: Theme.text-2; wrap: char-wrap; }
                            HorizontalLayout {
                                spacing: 6px;
                                GhostButton { label: "Cancel"; clicked => { root.remove-confirm-open = false; } }
                                Rectangle { horizontal-stretch: 1; }
                                GhostButton { label: "Remove from List"; clicked => { root.confirm-remove-transfer(root.remove-confirm-id, false); } }
                                PrimaryButton { label: "Delete Files Too"; clicked => { root.confirm-remove-transfer(root.remove-confirm-id, true); } }
                            }
                        }
                    }
                }
            }

            if root.toast-visible : Rectangle {
                x: parent.width - self.width - 18px;
                y: parent.height - self.height - 18px;
                width: Math.min(420px, toast-label.preferred-width + 28px);
                height: toast-content.preferred-height;
                border-radius: Theme.radius-lg;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: root.toast-error ? Theme.danger : Theme.accent;
                drop-shadow-blur: 10px;
                drop-shadow-color: Theme.popover-shadow;
                toast-content := VerticalLayout {
                    padding: 9px;
                    padding-left: 14px;
                    padding-right: 14px;
                    toast-label := Text {
                        text: root.toast-text;
                        color: root.toast-error ? Theme.danger : Theme.text-1;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    if !root.is-maximized : ResizeGrip {
        x: 10px; y: 0px; width: parent.width - 20px; height: 5px;
        direction: 0;
        mouse-cursor: ns-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: 10px; y: parent.height - 5px; width: parent.width - 20px; height: 5px;
        direction: 1;
        mouse-cursor: ns-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: 0px; y: 10px; width: 5px; height: parent.height - 20px;
        direction: 2;
        mouse-cursor: ew-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: parent.width - 5px; y: 10px; width: 5px; height: parent.height - 20px;
        direction: 3;
        mouse-cursor: ew-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: 0px; y: 0px; width: 10px; height: 10px;
        direction: 4;
        mouse-cursor: nwse-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: parent.width - 10px; y: 0px; width: 10px; height: 10px;
        direction: 5;
        mouse-cursor: nesw-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: 0px; y: parent.height - 10px; width: 10px; height: 10px;
        direction: 6;
        mouse-cursor: nesw-resize;
        resize(direction) => { root.start-resize(direction); }
    }
    if !root.is-maximized : ResizeGrip {
        x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px;
        direction: 7;
        mouse-cursor: nwse-resize;
        resize(direction) => { root.start-resize(direction); }
    }
}
