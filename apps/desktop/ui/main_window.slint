                is-direct-http: root.add-is-direct-http;
                probe-title: root.add-probe-title;
                probe-meta: root.add-probe-meta;
                is-playlist: root.add-is-playlist;
                playlist-count: root.add-playlist-count;
                playlist-selected-count: root.add-playlist-selected-count;
                playlist-folder-name <=> root.add-playlist-folder-name;
                playlist-filter <=> root.add-playlist-filter;
                playlist-items: root.add-playlist-items;
                format-options: root.add-format-options;
                container-index <=> root.add-container-index;
