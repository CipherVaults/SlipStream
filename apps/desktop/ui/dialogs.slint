import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "./tokens.slint";
import {
    PrimaryButton,
    GhostButton,
    CircleIconButton,
    PillSwitch,
    CheckBoxRow,
    PillBadge,
    StyledLineEdit,
    StyledSelect,
} from "./widgets.slint";
import {
    FormatOptionModel,
    SubtitleItemModel,
    PlaylistItemModel,
    TorrentPreviewFileModel,
    BrowserCardModel,
    PaletteActionModel,
    QueueItem,
    WatchFolderItem,
    RssFeedRuleItem,
    SiteLoginItem,
    SiteGrabItemRow,
} from "./app_types.slint";

// Porcelain modal container helper
component OverlayBackdrop inherits Rectangle {
    callback backdrop-clicked();

    width: 100%;
    height: 100%;
    background: Theme.modal-backdrop;

    TouchArea {
        clicked => { root.backdrop-clicked(); }
    }
}

component DialogField inherits VerticalLayout {
    in property <string> label;
    in property <bool> porcelain: false;

    spacing: 4px;
    Text { text: root.label; font-size: 11.5px; color: root.porcelain ? Theme.add-muted : Theme.text-2; }
    @children
}

export component AddDownloadOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <string> source-text: "";
    in property <bool> probing: false;
    in property <bool> submitting: false;
    in property <string> error-text: "";
    // 0=Video, 1=Audio Only, 2=Subtitles, 3=Torrent / Magnet, 4=Batch URLs
    in-out property <int> active-tab: 0;
    in property <bool> has-probe: false;
    in property <bool> is-torrent-input: false;
    in property <bool> is-direct-http: false;
    in property <string> probe-title: "";
    in property <string> probe-meta: "";
    in property <bool> is-playlist: false;
    in property <int> playlist-count: 0;
    in property <int> playlist-selected-count: 0;
    in-out property <string> playlist-folder-name: "";
    in-out property <string> playlist-filter: "";
    in property <[PlaylistItemModel]> playlist-items: [];
    in property <[FormatOptionModel]> format-options: [];
    in-out property <int> container-index: 0;
    in-out property <int> audio-preset-index: 0;
    in-out property <bool> embed-subtitles: true;
    in-out property <bool> lossless-remux: true;
    in-out property <bool> normalize-audio: false;
    in property <[SubtitleItemModel]> subtitles: [];
    in property <bool> torrent-preview-loading: false;
    in property <bool> has-torrent-preview: false;
    in property <string> torrent-preview-name: "";
    in property <string> torrent-preview-meta: "";
    in property <int> torrent-preview-trackers: 0;
    in property <[TorrentPreviewFileModel]> torrent-preview-files: [];
    in-out property <string> torrent-preview-filter: "";
    in-out property <bool> torrent-start-paused: false;
    in-out property <bool> torrent-sequential: true;
    in-out property <string> save-dir: "";
    in-out property <int> threads-index: 1; // 0=32, 1=16, 2=8, 3=4
    in-out property <bool> advanced-open: false;
    in-out property <string> filename-override: "";
    in-out property <string> expected-sha256: "";
    in-out property <string> mirror-urls-text: "";
    in-out property <string> media-clip-start: "";
    in-out property <string> media-clip-end: "";
    in-out property <bool> media-split-chapters: false;
    in-out property <string> media-sponsorblock-text: "";
    in property <int> batch-preview-count: 0;
    in property <string> footer-hint: "";
    in-out property <string> batch-text: "";
    in property <int> batch-url-count: 0;
    in property <[string]> category-options: [];
    in property <[string]> queue-options: ["Main Queue"];
    in-out property <int> selected-queue-index: 0;
    in-out property <int> batch-category-index: 0;
    in-out property <bool> batch-start-paused: false;
    in-out property <string> batch-save-dir: "";
    callback batch-edited();
    callback batch-import();
    callback import-metalink-clicked();

    callback close-requested();
    callback source-edited(string);
    callback probe-clicked();
    callback cancel-torrent-preview-clicked();
    callback browse-torrent-clicked();
    callback torrent-preview-file-toggled(int);
    callback torrent-preview-select-all();
    callback torrent-preview-select-none();
    callback torrent-preview-filter-edited(string);
    callback browse-save-dir-clicked();
    callback format-selected(string);
    callback playlist-item-toggled(int);
    callback playlist-select-all();
    callback playlist-clear();
    callback subtitle-toggled(string);
    callback submit-clicked();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 636px;
            height: 604px;
            border-radius: 16px;
            background: Theme.add-surface;
            border-width: 1px;
            border-color: Theme.add-border-strong;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 18px;
            drop-shadow-color: #090C1470;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: 18px; padding-right: 22px; padding-bottom: 18px; padding-left: 22px;
                spacing: 12px;

                // Header
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Add Download";
                        font-family: Theme.font-display;
                        font-size: 16.5px;
                        font-weight: 700;
                        color: Theme.add-text;
                        vertical-alignment: center;
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        porcelain: true;
                        clicked => { root.close-requested(); }
                    }
                }

                // URL input + Probe button
                if root.active-tab != 4 : VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "URL, magnet link, .torrent path, or wildcard pattern";
                        font-size: 11.5px;
                        font-weight: 550;
                        color: Theme.add-muted;
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        StyledLineEdit {
                            horizontal-stretch: 1;
                            porcelain: true;
                            mono: true;
                            text <=> root.source-text;
                            read-only: root.submitting;
                            placeholder: "https://... or magnet:?xt=urn:btih:... or image-[001-050].jpg";
                            edited(val) => { root.source-edited(val); }
                            accepted => { root.probe-clicked(); }
                        }
                        if root.active-tab == 3 : GhostButton {
                            label: "Browse";
                            enabled: !root.submitting;
                            porcelain: true;
                            btn-height: 31px;
                            clicked => { root.browse-torrent-clicked(); }
                        }
                        GhostButton {
                            label: root.is-torrent-input
                                ? (root.torrent-preview-loading ? "Cancel inspection" : "Inspect")
                                : (root.probing ? "Probing..." : "Probe");
                            porcelain: true;
                            btn-height: 31px;
                            enabled: !root.submitting && (root.is-torrent-input || !root.probing);
                            clicked => {
                                if (root.torrent-preview-loading) {
                                    root.cancel-torrent-preview-clicked();
                                } else {
                                    root.probe-clicked();
                                }
                            }
                        }
                    }
                }

                // Tabs
                Rectangle {
                    height: 34px;
                    border-radius: 10px;
                    background: Theme.add-raised;
                    border-width: 1px;
                    border-color: Theme.add-border;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 3px;
                        for t in [
                            { idx: 0, label: "Video / HTTP" },
                            { idx: 1, label: "Audio Only" },
                            { idx: 2, label: "Subtitles" },
                            { idx: 3, label: "Torrent / Magnet" },
                            { idx: 4, label: "Batch URLs" },
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 7px;
                            background: root.active-tab == t.idx
                                ? Theme.add-surface
                                : (tab-ta.has-hover ? Theme.add-hover : transparent);
                            drop-shadow-blur: root.active-tab == t.idx ? 4px : 0px;
                            drop-shadow-color: #0F172A18;

                            Text {
                                text: t.label;
                                font-size: 12px;
                                font-weight: root.active-tab == t.idx ? 600 : 500;
                                color: root.active-tab == t.idx ? Theme.add-text : Theme.add-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            tab-ta := TouchArea {
                                mouse-cursor: pointer;
                                enabled: !root.submitting;
                                clicked => { root.active-tab = t.idx; }
                            }
                        }
                    }
                }

                if root.active-tab == 4 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Enter one URL or magnet link per line";
                            color: Theme.add-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        GhostButton {
                            label: "Import .txt / .ef2…";
                            porcelain: true;
                            enabled: !root.submitting;
                            clicked => { root.batch-import(); }
                        }
                    }
                    TextEdit {
                        vertical-stretch: 1;
                        text <=> root.batch-text;
                        read-only: root.submitting;
                        placeholder-text: "https://example.org/file.zip";
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        edited => { root.batch-edited(); }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Save Folder"; font-size: 12px; color: Theme.add-muted; }
                        HorizontalLayout {
                            spacing: 8px;
                            StyledLineEdit {
                                horizontal-stretch: 1;
                                porcelain: true;
                                mono: true;
                                read-only: root.submitting;
                                text <=> root.batch-save-dir;
                                placeholder: "Use the category or default folder";
                            }
                            GhostButton {
                                label: "Browse";
                                porcelain: true;
                                enabled: !root.submitting;
                                clicked => { root.browse-save-dir-clicked(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Text { text: "Category"; font-size: 12px; color: Theme.add-muted; }
                            StyledSelect {
                                porcelain: true;
                                enabled: !root.submitting;
                                options: root.category-options;
                                current-index <=> root.batch-category-index;
                                current-value: root.category-options[root.batch-category-index];
                            }
                        }
                        PillSwitch {
                            checked <=> root.batch-start-paused;
                            enabled: !root.submitting;
                            label: "Start Paused";
                            porcelain: true;
                        }
                    }
                }

                // Scrollable body
                if root.active-tab != 4 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 11px;
                        padding-right: 4px;

                        // Probe header summary
                        if root.has-probe : Rectangle {
                            height: 68px;
                            border-radius: 10px;
                            background: Theme.add-raised;
                            border-width: 1px;
                            border-color: Theme.add-border;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 11px;

                                Image {
                                    source: @image-url("assets/media-sheet.svg");
                                    width: 96px;
                                    height: 52px;
                                    image-fit: cover;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: root.probe-title;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.add-text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.probe-meta;
                                        font-size: 11.5px;
                                        color: Theme.add-muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Batch hint
                        if root.batch-preview-count > 0 : Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.add-accent-soft;
                            border-width: 1px;
                            border-color: Theme.add-border;

                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                Text {
                                    text: "Wildcard batch ready: " + root.batch-preview-count + " files will be queued in parallel.";
                                    font-size: 12px;
                                    font-weight: 550;
                                    color: Theme.add-accent;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Playlist Picker when playlist probed
                        if root.is-playlist && (root.active-tab == 0 || root.active-tab == 1) : Rectangle {
                            border-radius: 10px;
                            background: Theme.add-raised;
                            border-width: 1px;
                            border-color: Theme.add-border;
                            height: 205px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Playlist Items (" + root.playlist-selected-count + "/" + root.playlist-count + ")";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.add-text;
                                        vertical-alignment: center;
                                    }
                                    GhostButton {
                                        label: "All";
                                        porcelain: true;
                                        btn-height: 24px;
                                        pad-x: 8px;
                                        clicked => { root.playlist-select-all(); }
                                    }
                                    GhostButton {
                                        label: "Clear";
                                        porcelain: true;
                                        btn-height: 24px;
                                        pad-x: 8px;
                                        clicked => { root.playlist-clear(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    StyledLineEdit {
                                        horizontal-stretch: 1;
                                        porcelain: true;
                                        box-height: 27px;
                                        text <=> root.playlist-folder-name;
                                        placeholder: "Playlist folder name";
                                    }
                                    StyledLineEdit {
                                        width: 165px;
                                        porcelain: true;
                                        box-height: 27px;
                                        text <=> root.playlist-filter;
                                        placeholder: "Filter entries...";
                                    }
                                }

                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 2px;
                                        for item in root.playlist-items : Rectangle {
                                            height: 26px;
                                            border-radius: 6px;
                                            background: item-ta.has-hover ? Theme.add-hover : transparent;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                CheckBoxRow {
                                                    controlled: true;
                                                    checked: item.checked;
                                                    porcelain: true;
                                                    toggled(_) => { root.playlist-item-toggled(item.index); }
                                                }
                                                Text {
                                                    width: 24px;
                                                    text: item.index + ".";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.add-muted;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: item.title;
                                                    font-size: 12px;
                                                    color: Theme.add-text;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: item.duration-text;
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.add-muted;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            item-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.playlist-item-toggled(item.index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-tab == 0 && !root.is-torrent-input && (!root.has-probe || root.is-direct-http) : VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Mirrors (one URL per line or comma-separated)";
                                    font-size: 11.5px;
                                    color: Theme.add-muted;
                                    vertical-alignment: center;
                                }
                                GhostButton {
                                    label: "Import Metalink...";
                                    porcelain: true;
                                    enabled: !root.submitting;
                                    clicked => { root.import-metalink-clicked(); }
                                }
                            }
                            TextEdit {
                                height: 58px;
                                text <=> root.mirror-urls-text;
                                read-only: root.submitting;
                                placeholder-text: "https://mirror.example.org/file.zip";
                                font-family: Theme.font-mono;
                                font-size: 12px;
                            }
                        }

                        if root.active-tab == 1 || (root.has-probe && !root.is-direct-http && root.active-tab <= 2) : HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            DialogField {
                                width: 85px;
                                label: "Clip Start (s)";
                                porcelain: true;
                                StyledLineEdit { porcelain: true; text <=> root.media-clip-start; placeholder: "Optional"; }
                            }
                            DialogField {
                                width: 85px;
                                label: "Clip End (s)";
                                porcelain: true;
                                StyledLineEdit { porcelain: true; text <=> root.media-clip-end; placeholder: "Optional"; }
                            }
                            DialogField {
                                horizontal-stretch: 1;
                                label: "SponsorBlock";
                                porcelain: true;
                                StyledLineEdit { porcelain: true; text <=> root.media-sponsorblock-text; placeholder: "sponsor, intro"; }
                            }
                            CheckBoxRow {
                                y: parent.height - self.height - 3px;
                                width: 123px;
                                porcelain: true;
                                label: "Split chapters";
                                checked <=> root.media-split-chapters;
                            }
                        }

                        // Tab 0: Video options
                        if root.active-tab == 0 : VerticalLayout {
                            spacing: 9px;

                            if root.is-direct-http : Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: Theme.add-accent-soft;
                                border-width: 1px;
                                border-color: Theme.add-border;

                                HorizontalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Direct HTTP download";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.add-text;
                                        vertical-alignment: center;
                                    }
                                    PillBadge { text: "HTTP"; tone: 4; }
                                }
                            }

                            if root.has-probe && root.format-options.length > 0 : VerticalLayout {
                                spacing: 5px;
                                Text {
                                    text: "Video Format";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: Theme.add-muted;
                                }
                                for fmt in root.format-options : Rectangle {
                                    height: 36px;
                                    border-radius: 8px;
                                    background: fmt.selected
                                        ? Theme.add-accent-soft
                                        : (f-ta.has-hover ? Theme.add-hover : Theme.add-raised);
                                    border-width: 1px;
                                    border-color: fmt.selected ? Theme.add-accent : Theme.add-border;

                                    HorizontalLayout {
                                        padding-left: 11px;
                                        padding-right: 11px;
                                        spacing: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: fmt.title;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.add-text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: fmt.detail;
                                            font-family: Theme.font-mono;
                                            font-size: 11.5px;
                                            color: Theme.add-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                    f-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.format-selected(fmt.format-id); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                PillSwitch {
                                    checked <=> root.embed-subtitles;
                                    porcelain: true;
                                    label: "Embed Subtitles";
                                }
                                PillSwitch {
                                    checked <=> root.lossless-remux;
                                    porcelain: true;
                                    label: "Lossless Remux";
                                }
                                PillSwitch {
                                    checked <=> root.normalize-audio;
                                    porcelain: true;
                                    label: "Audio Track Normalization";
                                }
                            }

                            if root.has-probe : HorizontalLayout {
                                alignment: start;
                                spacing: 10px;
                                Text {
                                    text: "Container";
                                    font-size: 12px;
                                    color: Theme.add-muted;
                                    vertical-alignment: center;
                                }
                                StyledSelect {
                                    width: 150px;
                                    porcelain: true;
                                    options: ["MP4 (Universal)", "MKV (Lossless)", "WebM (VP9)"];
                                    current-index <=> root.container-index;
                                    current-value: root.container-index == 2 ? "WebM (VP9)"
                                        : (root.container-index == 1 ? "MKV (Lossless)" : "MP4 (Universal)");
                                }
                            }
                        }

                        // Tab 1: Audio Only
                        if root.active-tab == 1 : VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Audio Extraction Preset";
                                font-size: 11.5px;
                                font-weight: 600;
                                color: Theme.add-muted;
                            }
                            for preset in [
                                { idx: 0, label: "MP3 320 kbps", detail: "Universal compatibility" },
                                { idx: 1, label: "M4A / AAC 256 kbps", detail: "Stream copy or high quality AAC" },
                                { idx: 2, label: "Opus 160 kbps", detail: "Modern transparent compression" },
                                { idx: 3, label: "FLAC", detail: "Lossless archive" },
                                { idx: 4, label: "WAV", detail: "Uncompressed PCM" },
                            ] : Rectangle {
                                height: 34px;
                                border-radius: 8px;
                                background: root.audio-preset-index == preset.idx
                                    ? Theme.add-accent-soft
                                    : Theme.add-raised;
                                border-width: 1px;
                                border-color: root.audio-preset-index == preset.idx
                                    ? Theme.add-accent
                                    : Theme.add-border;

                                HorizontalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: preset.label;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Theme.add-text;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: preset.detail;
                                        font-size: 11.5px;
                                        color: Theme.add-muted;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.audio-preset-index = preset.idx; }
                                }
                            }
                        }

                        // Tab 2: Subtitles
                        if root.active-tab == 2 : VerticalLayout {
                            spacing: 6px;
                            if root.subtitles.length == 0 : Text {
                                text: "Probe a video URL first to see available subtitle tracks.";
                                font-size: 12px;
                                color: Theme.add-muted;
                            }
                            for sub in root.subtitles : Rectangle {
                                height: 30px;
                                border-radius: 7px;
                                background: Theme.add-raised;
                                border-width: 1px;
                                border-color: Theme.add-border;

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    spacing: 8px;
                                    CheckBoxRow {
                                        horizontal-stretch: 1;
                                        controlled: true;
                                        checked: sub.checked;
                                        porcelain: true;
                                        label: sub.label + (sub.is-auto ? " (Auto)" : "");
                                        toggled(_) => { root.subtitle-toggled(sub.lang); }
                                    }
                                }
                            }
                        }

                        if root.active-tab == 3 : VerticalLayout {
                            spacing: 8px;
                            if root.torrent-preview-loading : Rectangle {
                                background: Theme.add-accent-soft;
                                border-radius: Theme.radius-md;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text { text: "Fetching torrent metadata from peers & DHT..."; color: Theme.add-text; font-weight: 600; }
                                    Text { text: "Wait for inspection to finish or cancel it to continue."; color: Theme.add-muted; }
                                }
                            }
                            if root.has-torrent-preview : VerticalLayout {
                                spacing: 7px;
                                Rectangle {
                                    background: Theme.add-raised;
                                    border-radius: Theme.radius-md;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: root.torrent-preview-name; color: Theme.add-text; font-weight: 650; overflow: elide; }
                                        Text {
                                            text: root.torrent-preview-meta + "  •  " + root.torrent-preview-trackers
                                                + (root.torrent-preview-trackers == 1 ? " tracker" : " trackers");
                                            color: Theme.add-muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    GhostButton { label: "Select All"; porcelain: true; clicked => { root.torrent-preview-select-all(); } }
                                    GhostButton { label: "None"; porcelain: true; clicked => { root.torrent-preview-select-none(); } }
                                    StyledLineEdit {
                                        horizontal-stretch: 1;
                                        porcelain: true;
                                        placeholder: "Filter files...";
                                        text <=> root.torrent-preview-filter;
                                        edited(value) => { root.torrent-preview-filter-edited(value); }
                                    }
                                }
                                ScrollView {
                                    height: Math.clamp(root.torrent-preview-files.length * 26px, 38px, 150px);
                                    content-width: self.visible-width;
                                    VerticalLayout {
                                        alignment: start;
                                        if root.torrent-preview-files.length == 0 : Text {
                                            text: "No files match this filter.";
                                            color: Theme.add-muted;
                                        }
                                        for file in root.torrent-preview-files : HorizontalLayout {
                                            spacing: 8px;
                                            CheckBoxRow {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                controlled: true;
                                                porcelain: true;
                                                checked: file.checked;
                                                label: file.relative-path;
                                                toggled => { root.torrent-preview-file-toggled(file.index); }
                                            }
                                            Text {
                                                horizontal-stretch: 0;
                                                min-width: 68px;
                                                text: file.size-text;
                                                color: Theme.add-muted;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            PillSwitch {
                                checked <=> root.torrent-sequential;
                                porcelain: true;
                                label: "Sequential Download (Stream-friendly order)";
                            }
                            PillSwitch {
                                checked <=> root.torrent-start-paused;
                                porcelain: true;
                                label: "Add Paused (Download later)";
                            }
                        }

                        // Save folder & HTTP threads
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 8px;
                                background: Theme.add-input;
                                border-width: 1px;
                                border-color: Theme.add-border;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    spacing: 7px;
                                    Image {
                                        source: @image-url("icons/folder.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: Theme.add-muted;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    TextInput {
                                        horizontal-stretch: 1;
                                        text <=> root.save-dir;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.add-text;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                    GhostButton {
                                        label: "Browse";
                                        porcelain: true;
                                        btn-height: 24px;
                                        pad-x: 8px;
                                        clicked => { root.browse-save-dir-clicked(); }
                                    }
                                }
                            }

                            if root.active-tab != 3 && !root.is-torrent-input : HorizontalLayout {
                                spacing: 6px;
                                if root.is-direct-http && root.active-tab == 0 : Text {
                                    text: "Queue";
                                    font-size: 12px;
                                    color: Theme.add-muted;
                                    vertical-alignment: center;
                                }
                                if root.is-direct-http && root.active-tab == 0 : StyledSelect {
                                    width: 118px;
                                    porcelain: true;
                                    box-height: 34px;
                                    options: root.queue-options;
                                    current-index <=> root.selected-queue-index;
                                    current-value: root.queue-options[root.selected-queue-index];
                                }
                                Text {
                                    text: "Threads";
                                    font-size: 12px;
                                    color: Theme.add-muted;
                                    vertical-alignment: center;
                                }
                                StyledSelect {
                                    width: 72px;
                                    porcelain: true;
                                    box-height: 34px;
                                    options: ["32", "16", "8", "4"];
                                    current-index <=> root.threads-index;
                                    current-value: root.threads-index == 0 ? "32"
                                        : (root.threads-index == 2 ? "8" : (root.threads-index == 3 ? "4" : "16"));
                                }
                            }
                        }

                        // Advanced disclosure
                        VerticalLayout {
                            spacing: 7px;
                            Rectangle {
                                height: 22px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;
                                    Image {
                                        source: root.advanced-open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: Theme.add-muted;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Filename / Expected SHA-256";
                                        font-size: 12px;
                                        font-weight: 550;
                                        color: Theme.add-muted;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.advanced-open = !root.advanced-open; }
                                }
                            }

                            if root.advanced-open : HorizontalLayout {
                                spacing: 8px;
                                StyledLineEdit {
                                    horizontal-stretch: 1;
                                    porcelain: true;
                                    text <=> root.filename-override;
                                    placeholder: "Optional filename override";
                                }
                                StyledLineEdit {
                                    horizontal-stretch: 1;
                                    porcelain: true;
                                    mono: true;
                                    text <=> root.expected-sha256;
                                    placeholder: "Optional 64-hex SHA-256";
                                }
                            }
                        }
                    }
                }

                if root.error-text != "" : Text {
                    text: root.error-text;
                    font-size: 11.5px;
                    color: Theme.add-danger;
                    wrap: word-wrap;
                }

                // Footer
                Rectangle {
                    height: 1px;
                    background: Theme.add-border;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.active-tab == 4
                            ? root.batch-url-count + (root.batch-url-count == 1 ? " URL detected" : " URLs detected")
                            : root.footer-hint;
                        font-size: 11.5px;
                        color: Theme.add-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    GhostButton {
                        label: "Cancel";
                        porcelain: true;
                        clicked => { root.close-requested(); }
                    }
                    PrimaryButton {
                        label: root.submitting ? "Adding..." : root.active-tab == 4 ? "Queue All" : ((root.active-tab == 3 || root.is-torrent-input) && root.torrent-start-paused ? "Add Paused" : "Download");
                        icon: @image-url("icons/download.svg");
                        has-icon: true;
                        porcelain: true;
                        enabled: !root.submitting && (root.active-tab == 4 ? root.batch-url-count > 0
                            : !((root.active-tab == 3 || root.is-torrent-input) && root.torrent-preview-loading));
                        clicked => { root.submit-clicked(); }
                    }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> title;

    border-radius: 10px;
    background: Theme.bg-sidebar;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 11px;
        spacing: 7px;
        alignment: start;
        Text { text: root.title; font-size: 13px; font-weight: 650; color: Theme.text-1; }
        @children
    }
}

export component SettingsOverlay inherits Rectangle {
    in-out property <bool> open: false;
    // 0=General, 1=Automation, 2=BitTorrent, 3=Network
    in-out property <int> active-tab: 0;
    in-out property <int> proxy-mode-index: 0;
    in-out property <string> proxy-url: "";
    in-out property <string> proxy-username: "";
    in-out property <string> proxy-password: "";
    in property <bool> proxy-has-password: false;
    in-out property <string> proxy-bypass-hosts: "";
    in-out property <bool> proxy-apply-to-media: true;
    in property <[SiteLoginItem]> site-logins: [];
    in-out property <string> site-login-host: "";
    in-out property <int> site-login-scheme-index: 0;
    in-out property <string> site-login-username: "";
    in-out property <string> site-login-password: "";
    in property <bool> network-editing: false;
    in-out property <bool> cookies-enabled: false;
    in-out property <int> cookies-browser-index: 0;
    in-out property <string> cookies-allowed-hosts: "";
    in-out property <bool> auto-discover-checksums: true;
    in-out property <bool> media-embed-metadata: false;
    in-out property <bool> media-embed-thumbnail: false;
    in-out property <bool> media-embed-chapters: false;
    in-out property <bool> media-split-chapters: false;
    in-out property <string> media-sponsorblock-text: "";
    in-out property <string> media-filename-template: "";
    callback clear-proxy-password-clicked();
    callback add-site-login-clicked();
    callback delete-site-login-clicked(string);
    // 0=System, 1=Dark, 2=Light
    in-out property <int> theme-index: 1;
    // 0=Blue, 1=Mono
    in-out property <int> accent-index: 0;
    in-out property <string> default-download-dir: "";
    in-out property <string> default-connections: "16";
    in-out property <string> max-concurrent: "4";
    in-out property <string> speed-limit-mbps: "";
    in-out property <bool> close-to-tray: true;
    in-out property <bool> auto-defender-scan: true;
    in-out property <bool> monitor-clipboard: false;
    in-out property <bool> launch-on-startup: false;
    in-out property <bool> launch-minimized: false;
    in-out property <bool> notify-on-complete: true;
    in-out property <bool> sound-on-complete: false;
    in-out property <bool> show-drop-basket: false;
    in-out property <bool> show-download-dialog: true;
    in-out property <bool> show-progress-dialog: true;
    in-out property <bool> show-complete-dialog: true;
    // 0=Auto, 1=Manual
    in-out property <int> update-mode-index: 0;
    in-out property <string> ytdlp-override: "";
    in-out property <string> ffmpeg-override: "";
    in property <string> ytdlp-status-label: "Ready";
    in property <int> ytdlp-status-tone: 2;
    in property <string> ytdlp-version: "";
    in property <string> ytdlp-path: "";
    in property <string> ffmpeg-status-label: "Ready";
    in property <int> ffmpeg-status-tone: 2;
    in property <string> ffmpeg-version: "";
    in property <string> ffmpeg-path: "";
    in property <string> ffprobe-status-label: "Ready";
    in property <int> ffprobe-status-tone: 2;
    in property <string> ffprobe-path: "";
    in property <bool> ytdlp-updating: false;
    in property <string> ytdlp-notice: "";
    in property <string> ytdlp-error: "";
    in property <[BrowserCardModel]> browsers: [];
    in property <string> browser-notice: "";
    in property <string> browser-error: "";
    in property <string> about-version: "3.0.0";
    in property <bool> update-checking: false;
    in property <bool> update-installing: false;
    in property <bool> update-available: false;
    in property <string> update-version-label: "";
    in property <string> update-notes: "";
    in property <float> update-progress-percent: 0;
    in property <string> update-progress-text: "";
    in property <string> update-status-text: "";
    in property <string> update-error: "";
    in property <bool> saving: false;
    in property <string> error-text: "";

    // Phase 2 Automation Properties
    in-out property <bool> alt-speed-enabled: false;
    in-out property <string> alt-speed-kbps: "512";
    // 0=Disabled, 1=Off-Peak Window, 2=Snail Window
    in-out property <int> schedule-mode-index: 0;
    in-out property <string> schedule-start: "22:00";
    in-out property <string> schedule-end: "07:00";
    in-out property <bool> schedule-weekdays: false;
    in-out property <string> schedule-limit-kbps: "512";
    in-out property <bool> schedule-pause-outside: false;
    in-out property <bool> schedule-stop-torrents: false;
    in-out property <bool> guard-enabled: false;
    in-out property <bool> guard-fullscreen: true;
    in-out property <bool> guard-pause: false;
    in-out property <string> guard-limit-kbps: "256";
    in-out property <string> guard-processes: "zoom.exe, teams.exe, discord.exe";
    in property <[QueueItem]> queue-items: [];
    in-out property <string> new-queue-name: "";
    in-out property <string> new-queue-concurrent: "2";
    // 0=None, 1=Notify, 2=Sleep, 3=Shutdown
    in-out property <int> new-queue-post-action: 0;
    in property <[WatchFolderItem]> watch-folders: [];
    in-out property <bool> watch-delete-after-add: false;
    in-out property <bool> auto-extract-enabled: false;
    in-out property <bool> auto-extract-subfolder: true;
    in-out property <bool> auto-extract-overwrite: false;
    in-out property <bool> auto-extract-delete: false;
    in property <string> backup-notice: "";

    in-out property <string> bt-listen-port-start: "6881";
    in-out property <string> bt-listen-port-end: "6891";
    in-out property <bool> bt-enable-dht: true;
    in-out property <bool> bt-enable-upnp: false;
    in-out property <string> bt-global-upload-kbps: "";
    in-out property <string> bt-socks5-proxy: "";
    in-out property <string> bt-blocklist-path: "";
    in-out property <bool> bt-vpn-kill-switch: false;
    in property <[string]> bt-vpn-adapter-options: ["Custom adapter"];
    in-out property <int> bt-vpn-adapter-index: 0;
    in-out property <string> bt-vpn-adapter-custom: "";
    in property <bool> bt-adapters-refreshing: false;
    in-out property <string> bt-max-seed-ratio: "";
    in-out property <string> bt-max-seed-minutes: "";
    in-out property <bool> bt-stop-seeding-on-limit: true;
    in property <[RssFeedRuleItem]> rss-feeds: [];
    in-out property <string> new-rss-name: "";
    in-out property <string> new-rss-url: "";
    in-out property <string> new-rss-include: "";
    in-out property <string> new-rss-exclude: "";
    in-out property <string> new-rss-interval: "30";
    in property <bool> rss-polling: false;
    in property <bool> rss-editing: false;
    in property <string> rss-notice: "";
    in property <bool> rss-notice-error: false;
    property <bool> rss-busy: root.saving || root.rss-polling || root.rss-editing;

    callback close-requested();
    callback save-clicked();
    callback browse-download-dir();
    callback hibernate-now-clicked();
    callback refresh-toolchain-clicked();
    callback update-ytdlp-clicked();
    callback setup-browser-clicked(string);
    callback copy-text-clicked(string);
    callback check-updates-clicked();
    callback install-update-clicked();
    callback add-queue-clicked(string, string, int);
    callback remove-queue-clicked(string);
    callback add-watch-folder-clicked(bool);
    callback remove-watch-folder-clicked(string);
    callback export-backup-clicked();
    callback import-backup-clicked();
    callback browse-blocklist-clicked();
    callback refresh-vpn-adapters-clicked();
    callback add-rss-feed-clicked();
    callback remove-rss-feed-clicked(string);
    callback toggle-rss-feed-clicked(string);
    callback poll-rss-now-clicked();
    callback open-create-torrent-clicked();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 648px;
            height: root.active-tab == 3
                ? Math.min(810px, parent.height - 24px)
                : Math.min(642px, parent.height - 20px);
            border-radius: 16px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 18px;
            drop-shadow-color: #090C1470;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: 18px; padding-right: 22px; padding-bottom: 18px; padding-left: 22px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Settings";
                        font-family: Theme.font-display;
                        font-size: 16.5px;
                        font-weight: 700;
                        color: Theme.text-1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 354px;
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.bg-sidebar;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;
                            for t in [
                                { idx: 0, label: "General" },
                                { idx: 1, label: "Automation" },
                                { idx: 2, label: "BitTorrent" },
                                { idx: 3, label: "Network" },
                            ] : Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: root.active-tab == t.idx
                                    ? Theme.bg-elevated
                                    : (st-ta.has-hover ? Theme.bg-hover : transparent);
                                Text {
                                    text: t.label;
                                    font-size: 12px;
                                    font-weight: root.active-tab == t.idx ? 600 : 500;
                                    color: root.active-tab == t.idx ? Theme.text-1 : Theme.text-2;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                st-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.active-tab = t.idx;
                                        settings-scroll.content-y = 0px;
                                    }
                                }
                            }
                        }
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        clicked => { root.close-requested(); }
                    }
                }

                settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;

                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        padding-right: 6px;

                        if root.active-tab == 0 : VerticalLayout {
                            alignment: start;
                            spacing: 12px;

                        // Row 1: Theme & Accent
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: "Theme"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                                StyledSelect {
                                    options: ["System", "Dark (Graphite)", "Light (Porcelain)"];
                                    current-index <=> root.theme-index;
                                    current-value: root.theme-index == 0 ? "System"
                                        : (root.theme-index == 2 ? "Light (Porcelain)" : "Dark (Graphite)");
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: "Accent"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                                StyledSelect {
                                    options: ["Alpine Blue", "Monochrome"];
                                    current-index <=> root.accent-index;
                                    current-value: root.accent-index == 1 ? "Monochrome" : "Alpine Blue";
                                }
                            }
                        }

                        // Row 2: Default Download Folder
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Default Download Folder"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                            HorizontalLayout {
                                spacing: 7px;
                                StyledLineEdit {
                                    horizontal-stretch: 1;
                                    mono: true;
                                    text <=> root.default-download-dir;
                                }
                                GhostButton {
                                    label: "Browse";
                                    clicked => { root.browse-download-dir(); }
                                }
                            }
                        }

                        // Row 3: Numeric settings
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: "Default Connections (1-32)"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                                StyledLineEdit { mono: true; text <=> root.default-connections; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: "Max Concurrent"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                                StyledLineEdit { mono: true; text <=> root.max-concurrent; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: "Speed Limit (MB/s)"; font-size: 11.5px; font-weight: 600; color: Theme.text-2; }
                                StyledLineEdit { mono: true; text <=> root.speed-limit-mbps; placeholder: "Unlimited"; }
                            }
                        }

                        // Checkboxes / switches
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                spacing: 8px;

                                HorizontalLayout {
                                    PillSwitch {
                                        horizontal-stretch: 1;
                                        checked <=> root.close-to-tray;
                                        label: "Close to Tray (Hibernate to background)";
                                    }
                                    GhostButton {
                                        label: "Hibernate Now";
                                        btn-height: 26px;
                                        pad-x: 9px;
                                        clicked => { root.hibernate-now-clicked(); }
                                    }
                                }
                                PillSwitch {
                                    checked <=> root.launch-on-startup;
                                    label: "Launch SlipStream when Windows starts";
                                }
                                PillSwitch {
                                    checked <=> root.launch-minimized;
                                    label: "Start minimized to tray";
                                }
                                PillSwitch {
                                    checked <=> root.notify-on-complete;
                                    label: "Desktop notification on completion";
                                }
                                PillSwitch {
                                    checked <=> root.sound-on-complete;
                                    label: "Play sound on completion";
                                }
                                PillSwitch {
                                    checked <=> root.show-drop-basket;
                                    label: "Show always-on-top Drop Basket";
                                }
                                PillSwitch {
                                    checked <=> root.auto-defender-scan;
                                    label: "Automatic Windows Defender scan on completion";
                                }
                                PillSwitch {
                                    checked <=> root.monitor-clipboard;
                                    label: "Monitor clipboard for supported download links";
                                }
                            }
                        }

                        // Floating Download Boxes
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                spacing: 7px;
                                Text { text: "Floating Download Boxes"; font-size: 12px; font-weight: 600; color: Theme.text-1; }
                                PillSwitch {
                                    checked <=> root.show-download-dialog;
                                    label: "Show download info / duplicate dialog for browser downloads";
                                }
                                PillSwitch {
                                    checked <=> root.show-progress-dialog;
                                    label: "Show floating download progress window";
                                }
                                PillSwitch {
                                    checked <=> root.show-complete-dialog;
                                    label: "Show floating download complete dialog";
                                }
                            }
                        }

                        // Media Toolchain
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Media Toolchain";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text-1;
                                        vertical-alignment: center;
                                    }
                                    GhostButton {
                                        label: "Refresh";
                                        btn-height: 25px;
                                        pad-x: 9px;
                                        clicked => { root.refresh-toolchain-clicked(); }
                                    }
                                    GhostButton {
                                        label: root.ytdlp-updating ? "Updating..." : "Update yt-dlp";
                                        btn-height: 25px;
                                        pad-x: 9px;
                                        enabled: !root.ytdlp-updating;
                                        clicked => { root.update-ytdlp-clicked(); }
                                    }
                                }

                                for tc in [
                                    { name: "yt-dlp", status: root.ytdlp-status-label, tone: root.ytdlp-status-tone, info: root.ytdlp-version + "  " + root.ytdlp-path },
                                    { name: "FFmpeg", status: root.ffmpeg-status-label, tone: root.ffmpeg-status-tone, info: root.ffmpeg-version + "  " + root.ffmpeg-path },
                                    { name: "ffprobe", status: root.ffprobe-status-label, tone: root.ffprobe-status-tone, info: root.ffprobe-path },
                                ] : HorizontalLayout {
                                    spacing: 8px;
                                    Text { width: 58px; text: tc.name; font-size: 12px; font-weight: 600; color: Theme.text-1; vertical-alignment: center; }
                                    PillBadge { text: tc.status; tone: tc.tone; }
                                    Text { horizontal-stretch: 1; text: tc.info; font-family: Theme.font-mono; font-size: 10.5px; color: Theme.text-3; overflow: elide; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    StyledLineEdit { horizontal-stretch: 1; mono: true; text <=> root.ytdlp-override; placeholder: "Custom yt-dlp.exe path (optional)"; }
                                    StyledLineEdit { horizontal-stretch: 1; mono: true; text <=> root.ffmpeg-override; placeholder: "Custom ffmpeg.exe path (optional)"; }
                                }

                                if root.ytdlp-notice != "" : Text { text: root.ytdlp-notice; font-size: 11.5px; color: Theme.green; wrap: word-wrap; }
                                if root.ytdlp-error != "" : Text { text: root.ytdlp-error; font-size: 11.5px; color: Theme.danger; wrap: word-wrap; }
                            }
                        }

                        // Browser Integration
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                spacing: 7px;
                                Text { text: "Browser Extension & Native Host"; font-size: 12px; font-weight: 600; color: Theme.text-1; }

                                for br in root.browsers : Rectangle {
                                    height: 36px;
                                    border-radius: 8px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: br.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-1;
                                            vertical-alignment: center;
                                        }
                                        PillBadge {
                                            text: br.native-host-registered ? "Host Registered" : (br.installed ? "Detected" : "Not Found");
                                            tone: br.native-host-registered ? 2 : (br.installed ? 1 : 0);
                                        }
                                        GhostButton {
                                            label: "Setup & Connect";
                                            btn-height: 24px;
                                            pad-x: 9px;
                                            clicked => { root.setup-browser-clicked(br.id); }
                                        }
                                    }
                                }

                                if root.browser-notice != "" : Text { text: root.browser-notice; font-size: 11.5px; color: Theme.green; wrap: word-wrap; }
                                if root.browser-error != "" : Text { text: root.browser-error; font-size: 11.5px; color: Theme.danger; wrap: word-wrap; }
                            }
                        }

                        // About & Updates
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Image {
                                        source: @image-url("../icons/icon.png");
                                        width: 28px;
                                        height: 28px;
                                        image-fit: contain;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: "SlipStream v" + root.about-version;
                                            font-size: 12.5px;
                                            font-weight: 650;
                                            color: Theme.text-1;
                                        }
                                        Text {
                                            text: "By Mohamed Sayed • Publisher: CipherVaults • MIT";
                                            font-size: 11px;
                                            color: Theme.text-3;
                                        }
                                    }
                                    StyledSelect {
                                        width: 126px;
                                        options: ["Auto Check", "Manual Only"];
                                        current-index <=> root.update-mode-index;
                                        current-value: root.update-mode-index == 1 ? "Manual Only" : "Auto Check";
                                    }
                                    GhostButton {
                                        label: root.update-checking ? "Checking..." : "Check for Updates";
                                        enabled: !root.update-checking && !root.update-installing;
                                        clicked => { root.check-updates-clicked(); }
                                    }
                                }

                                if root.update-available : HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Update available: " + root.update-version-label;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                    PrimaryButton {
                                        label: root.update-installing ? "Installing..." : "Install Update & Restart";
                                        enabled: !root.update-installing;
                                        clicked => { root.install-update-clicked(); }
                                    }
                                }

                                if root.update-installing && root.update-progress-text != "" : VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 3px;
                                        background: Theme.track;
                                        Rectangle {
                                            width: parent.width * Math.clamp(root.update-progress-percent, 0.0, 1.0);
                                            height: 5px;
                                            border-radius: 3px;
                                            background: Theme.accent;
                                        }
                                    }
                                    Text {
                                        text: root.update-progress-text;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        color: Theme.text-2;
                                    }
                                }

                                if root.update-status-text != "" : Text { text: root.update-status-text; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                                if root.update-error != "" : Text { text: root.update-error; font-size: 11.5px; color: Theme.danger; wrap: word-wrap; }
                            }
                        }
                        }

                        // ==================== AUTOMATION TAB ====================
                        if root.active-tab == 1 : VerticalLayout {
                            alignment: start;
                            spacing: 12px;

                            // Card 1: Snail Mode & Time Scheduler
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.bg-sidebar;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                    spacing: 8px;
                                    Text { text: "Snail Mode & Time Scheduler"; font-size: 12px; font-weight: 600; color: Theme.text-1; }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        PillSwitch {
                                            horizontal-stretch: 1;
                                            checked <=> root.alt-speed-enabled;
                                            label: "Enable Snail / Alt Speed cap";
                                        }
                                        StyledLineEdit {
                                            width: 120px;
                                            mono: true;
                                            text <=> root.alt-speed-kbps;
                                            placeholder: "512 KiB/s";
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 2;
                                            spacing: 4px;
                                            Text { text: "Schedule Mode"; font-size: 11px; color: Theme.text-2; }
                                            StyledSelect {
                                                options: ["Disabled", "Off-Peak Window", "Snail Window"];
                                                current-index <=> root.schedule-mode-index;
                                                current-value: root.schedule-mode-index == 1 ? "Off-Peak Window"
                                                    : (root.schedule-mode-index == 2 ? "Snail Window" : "Disabled");
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Text { text: "Start (HH:MM)"; font-size: 11px; color: Theme.text-2; }
                                            StyledLineEdit { mono: true; text <=> root.schedule-start; placeholder: "22:00"; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Text { text: "End (HH:MM)"; font-size: 11px; color: Theme.text-2; }
                                            StyledLineEdit { mono: true; text <=> root.schedule-end; placeholder: "07:00"; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Text { text: "Limit (KiB/s)"; font-size: 11px; color: Theme.text-2; }
                                            StyledLineEdit { mono: true; text <=> root.schedule-limit-kbps; placeholder: "512"; }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        PillSwitch { checked <=> root.schedule-weekdays; label: "Weekdays only"; }
                                        PillSwitch { checked <=> root.schedule-pause-outside; enabled: root.schedule-mode-index == 1; label: "Pause outside window"; }
                                        PillSwitch { checked <=> root.schedule-stop-torrents; label: "Pause torrents at end"; }
                                    }
                                }
                            }

                            // Card 2: Smart Bandwidth Guard (Game / Call Mode)
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.bg-sidebar;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                    spacing: 8px;
                                    Text { text: "Smart Bandwidth Guard (Game / Call Mode)"; font-size: 12px; font-weight: 600; color: Theme.text-1; }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        PillSwitch { horizontal-stretch: 1; checked <=> root.guard-enabled; label: "Enable Smart Bandwidth Guard"; }
                                        VerticalLayout {
                                            width: 120px;
                                            StyledLineEdit { mono: true; text <=> root.guard-limit-kbps; placeholder: "256 KiB/s"; }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        PillSwitch { checked <=> root.guard-fullscreen; label: "Detect fullscreen apps"; }
                                        PillSwitch { checked <=> root.guard-pause; label: "Pause instead of throttling"; }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Watched processes (comma-separated .exe)"; font-size: 11px; color: Theme.text-2; }
                                        StyledLineEdit {
                                            mono: true;
                                            text <=> root.guard-processes;
                                            placeholder: "zoom.exe, teams.exe, discord.exe, obs64.exe";
                                        }
                                    }
                                }
                            }

                            // Card 3: Named Queues & Post-Queue Power Actions
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.bg-sidebar;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                    spacing: 7px;
                                    Text { text: "Download Queues & Post-Completion Actions"; font-size: 12px; font-weight: 600; color: Theme.text-1; }

                                    for q in root.queue-items : Rectangle {
                                        height: 32px;
                                        border-radius: 7px;
                                        background: Theme.bg-elevated;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        HorizontalLayout {
                                            padding-left: 9px; padding-right: 7px; spacing: 8px;
                                            Text { horizontal-stretch: 1; text: q.name + " (" + q.id + ")"; font-size: 11.5px; font-weight: 600; color: Theme.text-1; vertical-alignment: center; overflow: elide; }
                                            PillBadge { text: "Max " + q.max-concurrent; tone: 0; y: (parent.height - self.height) / 2; }
                                            PillBadge { text: q.post-action; tone: q.post-action == "None" ? 0 : 1; y: (parent.height - self.height) / 2; }
                                            if q.id != "default" : CircleIconButton {
                                                icon: @image-url("icons/trash-2.svg");
                                                ghost-square: true;
                                                clicked => { root.remove-queue-clicked(q.id); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        StyledLineEdit { horizontal-stretch: 2; text <=> root.new-queue-name; placeholder: "New queue name"; }
                                        StyledLineEdit { width: 64px; mono: true; text <=> root.new-queue-concurrent; placeholder: "Max"; }
                                        StyledSelect {
                                            width: 114px;
                                            options: ["None", "Notify", "Sleep", "Shutdown"];
                                            current-index <=> root.new-queue-post-action;
                                            current-value: root.new-queue-post-action == 1 ? "Notify"
                                                : (root.new-queue-post-action == 2 ? "Sleep" : (root.new-queue-post-action == 3 ? "Shutdown" : "None"));
                                        }
                                        GhostButton {
                                            label: "Add Queue";
                                            btn-height: 30px;
                                            clicked => {
                                                root.add-queue-clicked(root.new-queue-name, root.new-queue-concurrent, root.new-queue-post-action);
                                            }
                                        }
                                    }
                                }
                            }

                            // Card 4: Watch Folders (.torrent) & Auto-Extract
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.bg-sidebar;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                    spacing: 8px;
                                    Text { text: ".torrent Watch Folders & Safe Archive Auto-Extract"; font-size: 12px; font-weight: 600; color: Theme.text-1; }

                                    for wf in root.watch-folders : Rectangle {
                                        height: 30px;
                                        border-radius: 7px;
                                        background: Theme.bg-elevated;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        HorizontalLayout {
                                            padding-left: 9px; padding-right: 7px; spacing: 8px;
                                            Text { horizontal-stretch: 1; text: wf.folder; font-family: Theme.font-mono; font-size: 11px; color: Theme.text-1; vertical-alignment: center; overflow: elide; }
                                            if wf.delete-after-add : PillBadge { text: "Delete .torrent"; tone: 3; y: (parent.height - self.height) / 2; }
                                            CircleIconButton {
                                                icon: @image-url("icons/trash-2.svg");
                                                ghost-square: true;
                                                clicked => { root.remove-watch-folder-clicked(wf.id); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        GhostButton {
                                            label: "Add Watch Folder...";
                                            btn-height: 28px;
                                            clicked => { root.add-watch-folder-clicked(root.watch-delete-after-add); }
                                        }
                                        PillSwitch { checked <=> root.watch-delete-after-add; label: "Delete .torrent file after adding"; }
                                    }

                                    Rectangle { height: 1px; background: Theme.border; }

                                    PillSwitch { checked <=> root.auto-extract-enabled; label: "Auto-extract completed .zip, .tar.gz, .tar, .7z archives"; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        PillSwitch { checked <=> root.auto-extract-subfolder; label: "Create subfolder"; }
                                        PillSwitch { checked <=> root.auto-extract-overwrite; label: "Overwrite existing"; }
                                        PillSwitch { checked <=> root.auto-extract-delete; label: "Delete archive after extract"; }
                                    }
                                }
                            }

                            // Card 5: Portable Settings & Rules Backup
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.bg-sidebar;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-top: 11px; padding-right: 13px; padding-bottom: 11px; padding-left: 13px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "Portable Settings, Queues & Rules Backup";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-1;
                                            vertical-alignment: center;
                                        }
                                        GhostButton {
                                            label: "Export Backup...";
                                            btn-height: 28px;
                                            clicked => { root.export-backup-clicked(); }
                                        }
                                        GhostButton {
                                            label: "Import Backup...";
                                            btn-height: 28px;
                                            clicked => { root.import-backup-clicked(); }
                                        }
                                    }
                                    if root.backup-notice != "" : Text {
                                        text: root.backup-notice;
                                        font-size: 11.5px;
                                        color: Theme.green;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if root.active-tab == 2 : VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                SettingsCard {
                                    width: 340px;
                                    title: "Network & Privacy";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        DialogField {
                                            horizontal-stretch: 1;
                                            label: "Port start";
                                            StyledLineEdit { text <=> root.bt-listen-port-start; placeholder: "0 for off"; }
                                        }
                                        DialogField {
                                            horizontal-stretch: 1;
                                            label: "Port end";
                                            StyledLineEdit {
                                                text <=> root.bt-listen-port-end;
                                                enabled: root.bt-listen-port-start != "0";
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 9px;
                                        DialogField {
                                            horizontal-stretch: 1;
                                            label: "Global upload limit (KiB/s)";
                                            StyledLineEdit { text <=> root.bt-global-upload-kbps; placeholder: "Unlimited"; }
                                        }
                                        VerticalLayout {
                                            padding-bottom: 5px;
                                            alignment: end;
                                            HorizontalLayout {
                                                spacing: 9px;
                                                PillSwitch { label: "DHT"; checked <=> root.bt-enable-dht; }
                                                PillSwitch { label: "UPnP"; checked <=> root.bt-enable-upnp; }
                                            }
                                        }
                                    }
                                    DialogField {
                                        label: "SOCKS5 proxy";
                                        StyledLineEdit { text <=> root.bt-socks5-proxy; placeholder: "socks5://host:port"; }
                                    }
                                    DialogField {
                                        label: "IP blocklist";
                                        HorizontalLayout {
                                            spacing: 6px;
                                            StyledLineEdit {
                                                horizontal-stretch: 1;
                                                text <=> root.bt-blocklist-path;
                                                placeholder: "Blocklist file (optional)";
                                            }
                                            GhostButton {
                                                label: "Browse...";
                                                enabled: !root.saving;
                                                clicked => { root.browse-blocklist-clicked(); }
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    title: "VPN Kill Switch & Adapter";
                                    PillSwitch { label: "Enable kill switch"; checked <=> root.bt-vpn-kill-switch; }
                                    DialogField {
                                        label: "Network adapter";
                                        HorizontalLayout {
                                            spacing: 6px;
                                            StyledSelect {
                                                horizontal-stretch: 1;
                                                options: root.bt-vpn-adapter-options;
                                                current-index <=> root.bt-vpn-adapter-index;
                                                current-value: root.bt-vpn-adapter-options[root.bt-vpn-adapter-index];
                                            }
                                            GhostButton {
                                                label: "Refresh";
                                                enabled: !root.bt-adapters-refreshing && !root.saving;
                                                clicked => { root.refresh-vpn-adapters-clicked(); }
                                            }
                                        }
                                    }
                                    if root.bt-vpn-adapter-index == 0 : DialogField {
                                        label: "Custom adapter name";
                                        StyledLineEdit { text <=> root.bt-vpn-adapter-custom; placeholder: "Windows adapter name"; }
                                    }
                                    Text {
                                        text: "Torrent traffic is blocked when the configured adapter is disconnected.";
                                        wrap: word-wrap;
                                        font-size: 11.5px;
                                        color: Theme.text-2;
                                    }
                                }
                            }

                            SettingsCard {
                                title: "Seeding Limits";
                                HorizontalLayout {
                                    spacing: 10px;
                                    DialogField {
                                        horizontal-stretch: 1;
                                        label: "Maximum ratio";
                                        StyledLineEdit { text <=> root.bt-max-seed-ratio; placeholder: "Unlimited"; }
                                    }
                                    DialogField {
                                        horizontal-stretch: 1;
                                        label: "Maximum minutes";
                                        StyledLineEdit { text <=> root.bt-max-seed-minutes; placeholder: "Unlimited"; }
                                    }
                                    VerticalLayout {
                                        alignment: end;
                                        PillSwitch { label: "Stop at either limit"; checked <=> root.bt-stop-seeding-on-limit; }
                                    }
                                }
                            }

                            SettingsCard {
                                title: "RSS Auto-Downloader";
                                for feed in root.rss-feeds : Rectangle {
                                    border-radius: 7px;
                                    background: Theme.bg-elevated;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 3px;
                                                Text { text: feed.name; font-size: 12px; font-weight: 650; color: Theme.text-1; overflow: elide; }
                                                Text { text: feed.feed-url; font-size: 11px; color: Theme.text-2; overflow: elide; }
                                            }
                                            Text {
                                                text: "Every " + feed.poll-interval-minutes + " min";
                                                font-size: 11px;
                                                color: Theme.text-2;
                                                vertical-alignment: center;
                                            }
                                            GhostButton {
                                                label: feed.enabled ? "Disable" : "Enable";
                                                btn-height: 28px;
                                                enabled: !root.rss-busy;
                                                clicked => { root.toggle-rss-feed-clicked(feed.id); }
                                            }
                                            GhostButton {
                                                label: "Remove";
                                                btn-height: 28px;
                                                enabled: !root.rss-busy;
                                                clicked => { root.remove-rss-feed-clicked(feed.id); }
                                            }
                                        }
                                        Text {
                                            text: (feed.enabled ? (feed.auto-start ? "Auto-start" : "Add paused") : "Disabled")
                                                + (feed.include-pattern != "" ? "  ·  Include " + feed.include-pattern : "")
                                                + (feed.exclude-pattern != "" ? "  ·  Exclude " + feed.exclude-pattern : "");
                                            font-size: 11px;
                                            color: Theme.text-2;
                                            overflow: elide;
                                        }
                                        if feed.last-error != "" : Text {
                                            text: feed.last-error;
                                            color: Theme.danger;
                                            font-size: 11px;
                                            wrap: char-wrap;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    DialogField {
                                        horizontal-stretch: 1;
                                        label: "Feed name";
                                        StyledLineEdit { text <=> root.new-rss-name; enabled: !root.rss-editing; }
                                    }
                                    DialogField {
                                        horizontal-stretch: 2;
                                        label: "Feed URL";
                                        StyledLineEdit { text <=> root.new-rss-url; placeholder: "https://"; enabled: !root.rss-editing; }
                                    }
                                    DialogField {
                                        width: 86px;
                                        label: "Interval (min)";
                                        StyledLineEdit { text <=> root.new-rss-interval; enabled: !root.rss-editing; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    DialogField {
                                        horizontal-stretch: 1;
                                        label: "Include pattern";
                                        StyledLineEdit { text <=> root.new-rss-include; placeholder: "All titles"; enabled: !root.rss-editing; }
                                    }
                                    DialogField {
                                        horizontal-stretch: 1;
                                        label: "Exclude pattern";
                                        StyledLineEdit { text <=> root.new-rss-exclude; placeholder: "Optional"; enabled: !root.rss-editing; }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 8px;
                                    GhostButton {
                                        label: root.rss-polling ? "Polling..." : "Poll Now";
                                        enabled: !root.rss-busy && root.rss-feeds.length > 0;
                                        clicked => { root.poll-rss-now-clicked(); }
                                    }
                                    PrimaryButton {
                                        label: "Add Feed";
                                        enabled: !root.rss-busy && root.new-rss-url != "";
                                        clicked => { root.add-rss-feed-clicked(); }
                                    }
                                }
                                if root.rss-notice != "" : Text {
                                    text: root.rss-notice;
                                    font-size: 11.5px;
                                    color: root.rss-notice-error ? Theme.danger : Theme.text-2;
                                    wrap: char-wrap;
                                }
                            }
                        }

                        if root.active-tab == 3 : VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 10px;
                                SettingsCard {
                                    horizontal-stretch: 1;
                                    title: "HTTP Proxy & Privacy";
                                    DialogField {
                                        label: "Proxy mode";
                                        StyledSelect {
                                            options: ["Direct", "System", "Manual"];
                                            current-index <=> root.proxy-mode-index;
                                            current-value: self.options[root.proxy-mode-index];
                                        }
                                    }
                                    DialogField {
                                        label: "Proxy URL";
                                        StyledLineEdit { text <=> root.proxy-url; placeholder: "http://proxy.example.org:8080"; enabled: root.proxy-mode-index == 2; }
                                    }
                                    DialogField {
                                        label: "Username";
                                        StyledLineEdit { text <=> root.proxy-username; placeholder: "Optional"; enabled: root.proxy-mode-index == 2; }
                                    }
                                    DialogField {
                                        label: "Password";
                                        HorizontalLayout {
                                            spacing: 6px;
                                            StyledLineEdit {
                                                horizontal-stretch: 1;
                                                text <=> root.proxy-password;
                                                input-type: InputType.password;
                                                placeholder: root.proxy-has-password ? "Password saved" : "Optional";
                                                enabled: root.proxy-mode-index == 2;
                                            }
                                            if root.proxy-has-password || root.proxy-password != "" : GhostButton {
                                                label: "Clear";
                                                pad-x: 8px;
                                                enabled: !root.saving && !root.network-editing;
                                                clicked => { root.clear-proxy-password-clicked(); }
                                            }
                                        }
                                    }
                                    DialogField {
                                        label: "Bypass hosts";
                                        StyledLineEdit { text <=> root.proxy-bypass-hosts; placeholder: "*.example.org, <local>"; enabled: root.proxy-mode-index == 2; }
                                    }
                                    CheckBoxRow { label: "Apply proxy to media downloads"; checked <=> root.proxy-apply-to-media; }
                                }
                                SettingsCard {
                                    horizontal-stretch: 1;
                                    title: "Site Logins (DPAPI Vault)";
                                    if root.site-logins.length == 0 : Text {
                                        text: "No site logins saved";
                                        font-size: 11.5px;
                                        color: Theme.text-3;
                                    }
                                    for login in root.site-logins : HorizontalLayout {
                                        spacing: 5px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            Text {
                                                text: login.host-pattern;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.text-1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: login.auth-scheme + (login.username == "" ? "" : " · " + login.username)
                                                    + (login.enabled ? "" : " · Disabled");
                                                font-size: 11px;
                                                color: Theme.text-2;
                                                overflow: elide;
                                            }
                                        }
                                        if login.has-password : PillBadge { text: "Saved"; tone: 2; }
                                        CircleIconButton {
                                            icon: @image-url("icons/trash-2.svg");
                                            ghost-square: true;
                                            enabled: !root.saving && !root.network-editing;
                                            clicked => { root.delete-site-login-clicked(login.id); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 7px;
                                        DialogField {
                                            horizontal-stretch: 1;
                                            label: "Host pattern";
                                            StyledLineEdit { text <=> root.site-login-host; placeholder: "*.example.org"; enabled: !root.network-editing; }
                                        }
                                        DialogField {
                                            width: 87px;
                                            label: "Scheme";
                                            StyledSelect {
                                                options: ["Basic", "Bearer"];
                                                current-index <=> root.site-login-scheme-index;
                                                current-value: self.options[root.site-login-scheme-index];
                                                enabled: !root.network-editing;
                                            }
                                        }
                                    }
                                    DialogField {
                                        label: "Username";
                                        StyledLineEdit { text <=> root.site-login-username; placeholder: "For Basic authentication"; enabled: !root.network-editing; }
                                    }
                                    DialogField {
                                        label: root.site-login-scheme-index == 1 ? "Token" : "Password";
                                        StyledLineEdit { text <=> root.site-login-password; input-type: InputType.password; enabled: !root.network-editing; }
                                    }
                                    HorizontalLayout {
                                        Rectangle { horizontal-stretch: 1; }
                                        GhostButton {
                                            label: "Add Login";
                                            enabled: !root.saving && !root.network-editing
                                                && root.site-login-host != "" && root.site-login-password != "";
                                            clicked => { root.add-site-login-clicked(); }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 10px;
                                SettingsCard {
                                    horizontal-stretch: 1;
                                    title: "Browser Cookie Pass-Through & Checksums";
                                    CheckBoxRow {
                                        label: "Pass browser cookies to yt-dlp for allowlisted hosts";
                                        wrap-label: true;
                                        checked <=> root.cookies-enabled;
                                    }
                                    DialogField {
                                        label: "Browser";
                                        StyledSelect {
                                            options: ["Chrome", "Edge", "Brave", "Firefox"];
                                            current-index <=> root.cookies-browser-index;
                                            current-value: self.options[root.cookies-browser-index];
                                        }
                                    }
                                    DialogField {
                                        label: "Allowed hosts";
                                        StyledLineEdit { text <=> root.cookies-allowed-hosts; placeholder: "example.org, *.example.net"; }
                                    }
                                    CheckBoxRow { label: "Auto-discover SHA256SUMS"; checked <=> root.auto-discover-checksums; }
                                }
                                SettingsCard {
                                    horizontal-stretch: 1;
                                    title: "Media Power Tools";
                                    HorizontalLayout {
                                        spacing: 6px;
                                        CheckBoxRow { horizontal-stretch: 1; label: "Embed metadata"; checked <=> root.media-embed-metadata; }
                                        CheckBoxRow { horizontal-stretch: 1; label: "Embed thumbnail"; checked <=> root.media-embed-thumbnail; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        CheckBoxRow { horizontal-stretch: 1; label: "Embed chapters"; checked <=> root.media-embed-chapters; }
                                        CheckBoxRow { horizontal-stretch: 1; label: "Split chapters"; checked <=> root.media-split-chapters; }
                                    }
                                    DialogField {
                                        label: "SponsorBlock remove categories";
                                        StyledLineEdit { text <=> root.media-sponsorblock-text; placeholder: "sponsor, intro"; }
                                    }
                                    DialogField {
                                        label: "Filename template";
                                        StyledLineEdit { mono: true; text <=> root.media-filename-template; placeholder: "%(title)s"; }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.error-text != "" : Text {
                    text: root.error-text;
                    font-size: 11.5px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    if root.active-tab == 2 : GhostButton {
                        label: "Create .torrent...";
                        enabled: !root.saving;
                        clicked => { root.open-create-torrent-clicked(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        label: "Cancel";
                        enabled: !root.saving;
                        clicked => { root.close-requested(); }
                    }
                    PrimaryButton {
                        label: root.saving ? "Saving..." : "Save Settings";
                        enabled: !root.saving && !root.rss-editing && !root.network-editing;
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }
    }
}

export component SiteGrabberOverlay inherits Rectangle {
    in property <bool> open: false;
    in-out property <string> target-url: "";
    in-out property <int> depth-index: 0;
    in-out property <bool> same-origin-only: true;
    in-out property <string> extensions: "";
    in-out property <string> include-pattern: "";
    in-out property <string> exclude-pattern: "";
    in property <bool> scanning: false;
    in property <string> scanned-count-text: "";
    in property <[SiteGrabItemRow]> items: [];
    in property <int> selected-count: 0;
    in property <string> error-text: "";
    in property <bool> enqueuing: false;
    property <bool> busy: root.scanning || root.enqueuing;

    callback scan-clicked();
    callback select-all-clicked(bool);
    callback toggle-item-clicked(int);
    callback enqueue-selected-clicked();
    callback close-requested();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }
        Rectangle {
            width: Math.min(690px, parent.width - 32px);
            height: Math.min(580px, parent.height - 24px);
            border-radius: 16px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 18px;
            drop-shadow-color: #090C1470;
            clip: true;
            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Site Grabber";
                        font-family: Theme.font-display;
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text-1;
                        vertical-alignment: center;
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        clicked => { root.close-requested(); }
                    }
                }
                DialogField {
                    vertical-stretch: 0;
                    label: "Page URL";
                    StyledLineEdit {
                        mono: true;
                        text <=> root.target-url;
                        placeholder: "https://example.org/downloads/";
                        read-only: root.busy;
                        accepted => { if (!root.busy && root.target-url != "") { root.scan-clicked(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    DialogField {
                        width: 180px;
                        label: "Scan depth";
                        StyledSelect {
                            options: ["0 (This page)", "1 (Follow links)", "2 (Two hops)"];
                            current-index <=> root.depth-index;
                            current-value: self.options[root.depth-index];
                            enabled: !root.busy;
                        }
                    }
                    DialogField {
                        horizontal-stretch: 1;
                        label: "File extensions";
                        StyledLineEdit { text <=> root.extensions; placeholder: "zip, mp4, pdf"; read-only: root.busy; }
                    }
                    CheckBoxRow {
                        width: 143px;
                        y: parent.height - self.height - 3px;
                        label: "Same origin only";
                        checked <=> root.same-origin-only;
                        enabled: !root.busy;
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    DialogField {
                        horizontal-stretch: 1;
                        label: "Include pattern";
                        StyledLineEdit { text <=> root.include-pattern; placeholder: "*release*"; read-only: root.busy; }
                    }
                    DialogField {
                        horizontal-stretch: 1;
                        label: "Exclude pattern";
                        StyledLineEdit { text <=> root.exclude-pattern; placeholder: "*preview*"; read-only: root.busy; }
                    }
                    PrimaryButton {
                        label: root.scanning ? "Scanning..." : "Scan";
                        y: parent.height - self.height;
                        enabled: !root.busy && root.target-url != "";
                        clicked => { root.scan-clicked(); }
                    }
                }
                HorizontalLayout {
                    spacing: 7px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.scanned-count-text;
                        font-size: 12px;
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    GhostButton {
                        label: "Select All";
                        enabled: !root.busy && root.items.length > 0;
                        clicked => { root.select-all-clicked(true); }
                    }
                    GhostButton {
                        label: "Clear";
                        enabled: !root.busy && root.selected-count > 0;
                        clicked => { root.select-all-clicked(false); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: Theme.bg-sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            alignment: start;
                            padding: 6px;
                            spacing: 4px;
                            for item[i] in root.items : Rectangle {
                                height: 56px;
                                border-radius: 6px;
                                background: item.checked ? Theme.bg-hover : transparent;
                                HorizontalLayout {
                                    padding: 7px;
                                    spacing: 8px;
                                    CheckBoxRow {
                                        width: 19px;
                                        controlled: true;
                                        checked: item.checked;
                                        enabled: !root.busy;
                                        toggled => { root.toggle-item-clicked(i); }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        spacing: 2px;
                                        Text { text: item.filename; font-size: 12px; font-weight: 650; color: Theme.text-1; overflow: elide; }
                                        Text { text: item.url; font-size: 11px; color: Theme.text-2; overflow: elide; }
                                        Text { text: "From " + item.source-page; font-size: 10.5px; color: Theme.text-3; overflow: elide; }
                                    }
                                    PillBadge { text: item.kind; tone: 0; }
                                }
                            }
                        }
                    }
                }
                if root.error-text != "" : Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton { label: "Close"; clicked => { root.close-requested(); } }
                    PrimaryButton {
                        label: root.enqueuing ? "Queuing..." : "Queue Selected (" + root.selected-count + ")";
                        enabled: !root.busy && root.selected-count > 0;
                        clicked => { root.enqueue-selected-clicked(); }
                    }
                }
            }
        }
    }
}

export component CreateTorrentOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <string> source-path: "";
    in-out property <string> output-path: "";
    in-out property <string> trackers-text: "";
    in-out property <int> piece-size-index: 0;
    in-out property <bool> private-torrent: false;
    in-out property <string> comment: "";
    in property <bool> creating: false;
    in property <string> error-text: "";
    in property <string> success-text: "";
    property <[string]> piece-sizes: ["Auto", "256 KiB", "512 KiB", "1 MiB", "2 MiB", "4 MiB", "8 MiB", "16 MiB"];

    callback browse-source-file-clicked();
    callback browse-source-folder-clicked();
    callback browse-output-clicked();
    callback create-clicked();
    callback close-requested();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 560px;
            height: 492px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.bg-elevated;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 18px;
            drop-shadow-color: #090C1470;
            clip: true;
            TouchArea { }

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Create .torrent";
                        font-family: Theme.font-display;
                        font-size: 16.5px;
                        font-weight: 700;
                        color: Theme.text-1;
                        vertical-alignment: center;
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        enabled: !root.creating;
                        clicked => { root.close-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-right: 6px;
                        DialogField {
                            label: "Source file or folder";
                            HorizontalLayout {
                                spacing: 6px;
                                StyledLineEdit { text <=> root.source-path; horizontal-stretch: 1; read-only: root.creating; }
                                GhostButton { label: "File..."; enabled: !root.creating; clicked => { root.browse-source-file-clicked(); } }
                                GhostButton { label: "Folder..."; enabled: !root.creating; clicked => { root.browse-source-folder-clicked(); } }
                            }
                        }
                        DialogField {
                            label: "Output .torrent";
                            HorizontalLayout {
                                spacing: 6px;
                                StyledLineEdit {
                                    text <=> root.output-path;
                                    horizontal-stretch: 1;
                                    read-only: true;
                                    placeholder: "Choose where to save the .torrent";
                                }
                                GhostButton { label: "Browse..."; enabled: !root.creating; clicked => { root.browse-output-clicked(); } }
                            }
                        }
                        DialogField {
                            label: "Trackers";
                            Rectangle {
                                height: 76px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: trackers-input.has-focus ? Theme.accent : Theme.border;
                                background: Theme.bg-input;
                                ScrollView {
                                    x: 9px;
                                    y: 7px;
                                    width: parent.width - 18px;
                                    height: parent.height - 14px;
                                    content-width: self.visible-width;
                                    content-height: Math.max(self.visible-height, trackers-input.preferred-height);

                                    if root.trackers-text == "" && trackers-input.preedit-text == "" : Text {
                                        text: "One tracker URL per line";
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.text-3;
                                    }
                                    trackers-input := TextInput {
                                        text <=> root.trackers-text;
                                        read-only: root.creating;
                                        single-line: false;
                                        wrap: char-wrap;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.text-1;
                                        page-height: parent.visible-height;
                                        accessible-role: text-input;
                                        accessible-label: "Trackers";
                                        cursor-position-changed(pos) => {
                                            if (pos.y + parent.content-y < 0px) {
                                                parent.content-y = -pos.y;
                                            } else if (pos.y + parent.content-y > parent.visible-height - 16px) {
                                                parent.content-y = Math.max(parent.visible-height - parent.content-height,
                                                    parent.visible-height - 16px - pos.y);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            DialogField {
                                width: 160px;
                                label: "Piece size";
                                StyledSelect {
                                    enabled: !root.creating;
                                    options: root.piece-sizes;
                                    current-value: root.piece-sizes[root.piece-size-index];
                                    current-index <=> root.piece-size-index;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                PillSwitch { label: "Private torrent"; checked <=> root.private-torrent; enabled: !root.creating; }
                            }
                        }
                        DialogField {
                            label: "Comment (optional)";
                            StyledLineEdit { text <=> root.comment; read-only: root.creating; }
                        }
                    }
                }
                if root.error-text != "" || root.success-text != "" : Text {
                    text: root.error-text != "" ? root.error-text : root.success-text;
                    font-size: 11.5px;
                    color: root.error-text != "" ? Theme.danger : Theme.green;
                    wrap: char-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton { label: "Close"; enabled: !root.creating; clicked => { root.close-requested(); } }
                    PrimaryButton {
                        label: root.creating ? "Creating..." : "Create";
                        enabled: !root.creating && root.source-path != "" && root.output-path != "" && root.success-text == "";
                        clicked => { root.create-clicked(); }
                    }
                }
            }
        }
    }
}

export component CommandPaletteOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <string> query: "";
    in-out property <int> selected-index: 0;
    in property <[PaletteActionModel]> actions: [];

    callback close-requested();
    callback query-edited(string);
    callback action-triggered(string);

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 520px;
            height: Math.min(390px, 74px + root.actions.length * 36px);
            y: 96px;
            border-radius: 14px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 36px;
            drop-shadow-offset-y: 14px;
            drop-shadow-color: #090C1470;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                StyledLineEdit {
                    text <=> root.query;
                    placeholder: "Type a command or search...";
                    edited(q) => { root.query-edited(q); }
                    accepted => {
                        if (root.actions.length > 0 && root.selected-index < root.actions.length) {
                            root.action-triggered(root.actions[root.selected-index].id);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 3px;
                        for act[idx] in root.actions : Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: idx == root.selected-index || act-ta.has-hover
                                ? Theme.accent-soft
                                : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: act.label;
                                    font-size: 12.5px;
                                    font-weight: 550;
                                    color: Theme.text-1;
                                    vertical-alignment: center;
                                }
                                if act.hint != "" : PillBadge { text: act.hint; }
                            }
                            act-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.action-triggered(act.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component RefreshLinkOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> filename: "";
    in-out property <string> new-url: "";
    in property <bool> submitting: false;
    in property <string> error-text: "";

    callback close-requested();
    callback submit-clicked();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 460px;
            height: 215px;
            border-radius: 14px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 36px;
            drop-shadow-color: #090C1470;

            TouchArea { }

            VerticalLayout {
                padding-top: 18px; padding-right: 20px; padding-bottom: 18px; padding-left: 20px;
                spacing: 11px;

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Refresh Download Address";
                        font-family: Theme.font-display;
                        font-size: 15.5px;
                        font-weight: 700;
                        color: Theme.text-1;
                        vertical-alignment: center;
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        clicked => { root.close-requested(); }
                    }
                }

                Text {
                    text: root.filename;
                    font-size: 12px;
                    color: Theme.text-2;
                    overflow: elide;
                }

                StyledLineEdit {
                    mono: true;
                    text <=> root.new-url;
                    placeholder: "https://...";
                    accepted => { root.submit-clicked(); }
                }

                if root.error-text != "" : Text {
                    text: root.error-text;
                    font-size: 11.5px;
                    color: Theme.danger;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton { label: "Cancel"; clicked => { root.close-requested(); } }
                    PrimaryButton {
                        label: root.submitting ? "Updating..." : "Refresh & Resume";
                        enabled: !root.submitting;
                        clicked => { root.submit-clicked(); }
                    }
                }
            }
        }
    }
}

export component VerifyShaOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> filename: "";
    in-out property <string> expected-sha256: "";
    in property <bool> submitting: false;
    in property <string> error-text: "";

    callback close-requested();
    callback submit-clicked();

    if root.open : OverlayBackdrop {
        backdrop-clicked => { root.close-requested(); }

        Rectangle {
            width: 460px;
            height: 215px;
            border-radius: 14px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 36px;
            drop-shadow-color: #090C1470;

            TouchArea { }

            VerticalLayout {
                padding-top: 18px; padding-right: 20px; padding-bottom: 18px; padding-left: 20px;
                spacing: 11px;

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Verify SHA-256 Checksum";
                        font-family: Theme.font-display;
                        font-size: 15.5px;
                        font-weight: 700;
                        color: Theme.text-1;
                        vertical-alignment: center;
                    }
                    CircleIconButton {
                        icon: @image-url("icons/x.svg");
                        ghost-square: true;
                        clicked => { root.close-requested(); }
                    }
                }

                Text {
                    text: root.filename;
                    font-size: 12px;
                    color: Theme.text-2;
                    overflow: elide;
                }

                StyledLineEdit {
                    mono: true;
                    text <=> root.expected-sha256;
                    placeholder: "Paste 64-character SHA-256 hex digest";
                    accepted => { root.submit-clicked(); }
                }

                if root.error-text != "" : Text {
                    text: root.error-text;
                    font-size: 11.5px;
                    color: Theme.danger;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton { label: "Cancel"; clicked => { root.close-requested(); } }
                    PrimaryButton {
                        label: root.submitting ? "Verifying..." : "Verify File";
                        enabled: !root.submitting;
                        clicked => { root.submit-clicked(); }
                    }
                }
            }
        }
    }
}
