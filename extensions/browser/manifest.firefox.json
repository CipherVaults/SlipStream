{
  "manifest_version": 3,
  "name": "SlipStream",
  "version": "1.0.0",
  "description": "Send downloads and media to the SlipStream desktop app.",
  "permissions": ["nativeMessaging", "downloads", "webRequest", "contextMenus", "storage", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "SlipStream" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "slipstream@ciphervaults.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
