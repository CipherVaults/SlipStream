{
  "manifest_version": 3,
  "name": "SlipStream",
  "version": "2.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Send downloads and media to the SlipStream desktop app.",
  "permissions": ["nativeMessaging", "downloads", "webRequest", "contextMenus", "storage", "tabs", "alarms", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SlipStream",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["early.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "slipstream@ciphervaults.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
