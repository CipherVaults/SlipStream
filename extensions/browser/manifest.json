{
  "manifest_version": 3,
  "minimum_chrome_version": "123",
  "name": "SlipStream",
  "version": "0.1.0",
  "description": "Send downloads and media to the SlipStream desktop app.",
  "permissions": ["nativeMessaging", "downloads", "webRequest", "contextMenus", "storage", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SlipStream" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
