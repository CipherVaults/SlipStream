{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@slipstream/ipc-types": ["../../packages/ipc-types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
